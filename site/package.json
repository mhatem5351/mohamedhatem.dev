{
  "name": "mohamedhatem-dev-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "mohamedhatem.dev: the static Astro site (EN + AR). Builds to ../dist, which the Worker in ../worker serves.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run content:gen && astro dev",
    "build": "npm run content:gen && node scripts/og.mjs && astro build && node scripts/postbuild.mjs",
    "build:site": "astro build",
    "content:gen": "node ../worker/scripts/gen-content.mjs --quiet",
    "preview": "astro preview",
    "serve": "node scripts/serve.mjs",
    "check": "npm run content:gen && astro check",
    "test": "npm run test:unit && npm run test:static",
    "test:unit": "vitest run",
    "test:static": "node scripts/check-dist.mjs && node scripts/check-budgets.mjs && html-validate --config .htmlvalidate.json \"../dist/**/*.html\"",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "chrome-launcher": "^1.2.2",
    "html-validate": "^11.16.2",
    "lighthouse": "^13.5.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.0",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
