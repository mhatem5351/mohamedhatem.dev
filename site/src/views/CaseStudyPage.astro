---
/**
 * Case-study detail page (/work/<slug>/ and /ar/work/<slug>/), HANDOFF.md 2.5 and design/prototypes/case-study.html.
 *
 * Full case studies: hero (breadcrumbs, eyebrow, H1, summary, actions, meta card, key facts) with figure 1 (the
 * designed diagram, or the component view drawn from profile.ts), then an article with a sticky TOC: problem,
 * approach (+ an engineering decision where the sources state one), the product screens where the client approved
 * publishing them (ScreenGallery), architecture (component list, extra figures), outcome, stack, links, and where
 * the facts come from. Brief case studies (implementation details not public) are
 * compact and say so: a "Brief" tag in the eyebrow, no key-facts strip, then the problem, what I did and the outcome
 * next to a note card (why the page is short, where the facts come from, ask my AI), and the component view only
 * when it has more than five parts (a generic users-assistant-model view adds nothing to the text, audit HM-22). Both
 * end with the next case study and a CTA band. All copy: content/profile.ts, content/i18n (m.work.*), diagrams.json.
 */
import Base from "~/layouts/Base.astro";
import "~/styles/case.css";
import ReadingProgress from "~/components/case/ReadingProgress.astro";
import CaseHero from "~/components/case/CaseHero.astro";
import FigurePanel from "~/components/case/FigurePanel.astro";
import ComponentView from "~/components/case/ComponentView.astro";
import SiteShots from "~/components/case/SiteShots.astro";
import ScreenGallery from "~/components/case/ScreenGallery.astro";
import ZoomDialog from "~/components/case/ZoomDialog.astro";
import Toc from "~/components/case/Toc.astro";
import Decision from "~/components/case/Decision.astro";
import NextCase from "~/components/case/NextCase.astro";
import CaseCTA from "~/components/case/CaseCTA.astro";
import Icon from "~/components/ui/Icon.astro";
import BidiText from "~/components/ui/BidiText.astro";
import type { CaseStudy } from "@content/profile.ts";
import { dirOf, format, formatYears, messages, tr, type Locale } from "~/lib/i18n";
import { PATHS, byLocale, homeAnchor, nextCaseStudy } from "~/lib/site";
import { caseStudyJsonLd } from "~/lib/jsonld";
import { KIND_ACCENT, askQuestion, companyOf, decisionOf, diagramsOf, edgesOf, nodesByKind, roleOf, sourcesText, stackGroups, stackLabel, techAccent, tocOf } from "~/lib/case";

interface Props {
  locale: Locale;
  cs: CaseStudy;
}
const { locale, cs } = Astro.props;
const m = messages(locale);
const next = nextCaseStudy(cs.slug);
const brief = cs.depth === "brief";
const diagrams = diagramsOf(cs);
const [mainDiagram, ...moreDiagrams] = diagrams;
const decision = decisionOf(cs);
const steps = cs.approach.filter((_, i) => i !== decision?.index);
const toc = tocOf(cs, locale);
const groups = nodesByKind(cs);
const edges = edgesOf(cs, locale);
const question = askQuestion(cs, locale);
/** Brief pages draw the component view only when it says more than the text (more than five parts; HM-22). */
const briefFigure = brief && cs.architecture.nodes.length > 5;
/** logic-controls.com: the live site is figure 1 and the component view moves into the architecture section. */
const siteShots = !mainDiagram && cs.slug === "logic-controls-website";
/** A diagram of parts the client approved for publication gets its own note under it (HM-19, C7's key when present). */
const approved = cs.source.includes("mohamed");
const accent = (a: string) => (a === "neutral" ? undefined : `accent-${a}`);
const num = (id: string) => String(toc.findIndex((t) => t.id === id) + 1).padStart(2, "0");
const sources = format(m.work.page.sourcesBody, { sources: sourcesText(cs.source, locale) });
/** Describes this page's sharing card (scripts/og.mjs caseCard: title, then role · organisation · years). */
const role = roleOf(cs);
const ogAlt = format(m.meta.ogImageAltCase, {
  title: tr(cs.title, locale),
  role: role ? tr(role.title, locale) : m.work.freelance,
  company: companyOf(cs, locale),
  years: formatYears(cs.period),
});
---
<Base
  locale={locale}
  title={format(m.meta.caseStudy.title, { title: tr(cs.shortTitle, locale) })}
  description={tr(cs.summary, locale)}
  path={PATHS.work(cs.slug)}
  ogKey={`work-${cs.slug}`}
  ogImageAlt={ogAlt}
  ogType="article"
  article={{ published: cs.published, modified: cs.updated }}
  jsonLd={caseStudyJsonLd(cs.slug, locale)}
>
  <ReadingProgress />

  <CaseHero locale={locale} cs={cs} figureId={brief && !briefFigure ? undefined : "architecture"}>
    {
      !brief &&
        (mainDiagram ? (
          <FigurePanel locale={locale} id={mainDiagram} n={1} anchor="architecture" class="fig--hero" approved={approved} />
        ) : siteShots ? (
          <SiteShots locale={locale} n={1} class="fig--hero" />
        ) : (
          <ComponentView locale={locale} cs={cs} n={1} anchor="architecture" class="fig--hero" />
        ))
    }
  </CaseHero>

  {
    brief ? (
      <div class="container cs-brief">
        <article class="cs-brief__main cs-prose" aria-labelledby="cs-title">
          <section class="cs-brief__sec" id="problem" aria-labelledby="h-problem">
            <h2 class="cs-brief__h" id="h-problem">{m.work.labels.problem}</h2>
            <p class="lead">{tr(cs.problem, locale)}</p>
          </section>
          <section class="cs-brief__sec" id="approach" aria-labelledby="h-approach">
            <h2 class="cs-brief__h" id="h-approach">{m.work.page.whatIDid}</h2>
            <ul>
              {cs.approach.map((f) => (
                <li>{tr(f.text, locale)}</li>
              ))}
            </ul>
          </section>
          <section class="cs-brief__sec" id="outcome" aria-labelledby="h-outcome">
            <h2 class="cs-brief__h" id="h-outcome">{m.work.labels.outcome}</h2>
            <ul class="ticks" role="list">
              {cs.outcome.map((f) => (
                <li>
                  <span class="tick" aria-hidden="true">
                    <Icon name="check" />
                  </span>
                  <span>{tr(f.text, locale)}</span>
                </li>
              ))}
            </ul>
          </section>
          {
            briefFigure && (
              <section class="cs-brief__sec" id="components" aria-labelledby="h-components">
                <h2 class="cs-brief__h" id="h-components">{m.work.page.components}</h2>
                <ComponentView locale={locale} cs={cs} n={1} anchor="architecture" class="wide" />
              </section>
            )
          }
        </article>
        <aside class="cs-brief__aside" aria-labelledby="brief-note-title">
          <div class="card cs-brief__note">
            <p class="cs-brief__tag" id="brief-note-title">
              <Icon name="info" />
              {m.work.page.briefTitle}
            </p>
            <p>{m.work.briefNote}</p>
            <p class="cs-brief__src">{format(m.work.page.briefSources, { sources: sourcesText(cs.source, locale) })}</p>
            {/* One in-content "Ask my AI about this project" per page: the hero's (C-35; the header and the launcher
                offer the assistant everywhere). */}
            <a class="btn btn--ghost btn--sm" href={homeAnchor("work", locale, false)}>
              <Icon name="arrow-left" />
              {m.work.allWork}
            </a>
          </div>
        </aside>
      </div>
    ) : (
      <div class="container cs-layout">
        <Toc locale={locale} entries={toc} variant="mobile" />

        <article class="cs-article" aria-labelledby="cs-title">
          <section class="cs-sec" id="problem" aria-labelledby="h-problem">
            <div class="cs-sec__rule">
              <span class="sec-head__index" dir="ltr">{num("problem")}</span>
            </div>
            <h2 class="cs-sec__title" id="h-problem">
              {m.work.labels.problem}
            </h2>
            <div class="cs-prose">
              <p class="lead">{tr(cs.problem, locale)}</p>
            </div>
          </section>

          <section class="cs-sec" id="approach" aria-labelledby="h-approach">
            <div class="cs-sec__rule">
              <span class="sec-head__index" dir="ltr">{num("approach")}</span>
            </div>
            <h2 class="cs-sec__title" id="h-approach">
              {m.work.labels.approach}
            </h2>
            <div class="cs-prose">
              {decision && <Decision locale={locale} fact={decision.fact} />}
              <ol class="steps">
                {steps.map((f) => (
                  <li>
                    <span>{tr(f.text, locale)}</span>
                  </li>
                ))}
              </ol>
            </div>
          </section>

          {cs.screens && cs.screens.length > 0 && (
            <section class="cs-sec" id="screens" aria-labelledby="h-screens">
              <div class="cs-sec__rule">
                <span class="sec-head__index" dir="ltr">{num("screens")}</span>
              </div>
              <h2 class="cs-sec__title" id="h-screens">
                {m.work.labels.screens}
              </h2>
              <div class="cs-prose">
                <p>{m.work.page.screensCredit}</p>
                <ScreenGallery locale={locale} cs={cs} />
              </div>
            </section>
          )}

          <section class="cs-sec" id="components" aria-labelledby="h-components">
            <div class="cs-sec__rule">
              <span class="sec-head__index" dir="ltr">{num("components")}</span>
            </div>
            <h2 class="cs-sec__title" id="h-components">
              {m.work.labels.architecture}
            </h2>
            <div class="cs-prose">
              {siteShots ? (
                <ComponentView locale={locale} cs={cs} n={2} anchor="architecture" class="wide" />
              ) : (
                <p>
                  <BidiText text={tr(cs.architecture.caption, locale)} locale={locale} />{" "}
                  <a href="#architecture">{format(m.work.page.figure, { n: 1 })}</a>
                </p>
              )}
              {mainDiagram && (
                <dl class="arch-list wide">
                  {groups.map((g) => (
                    <div class:list={["arch-list__row", accent(KIND_ACCENT[g.kind])]}>
                      <dt>
                        <i aria-hidden="true" />
                        {m.work.legend[g.kind]}
                      </dt>
                      <dd>
                        <ul class="arch-list__items" role="list">
                          {g.nodes.map((n) => (
                            <li>
                              <BidiText text={tr(n.label, locale)} locale={locale} />
                              {n.note && (
                                <small>
                                  {" "}
                                  · <BidiText text={tr(n.note, locale)} locale={locale} />
                                </small>
                              )}
                            </li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                  ))}
                </dl>
              )}
              {/* The connections restate the figure's arrows: one click away instead of a long list (C-22). Opened for
                  print (script below). */}
              {mainDiagram && edges.length > 0 && (
                <details class="fig__desc arch-more wide" data-print-open>
                  <summary>
                    {m.work.page.connections} <span class="arch-more__n" dir="ltr">({edges.length})</span>
                    <Icon name="chevron-down" size="sm" />
                  </summary>
                  <ul class="arch-more__list" role="list">
                    {edges.map((e) => (
                      <li>
                        {m.work.page.connection.split(/(\{from\}|\{to\})/).filter(Boolean).map((bit) =>
                          bit === "{from}" || bit === "{to}" ? (
                            <bdi dir={dirOf(locale)}><BidiText text={bit === "{from}" ? e.from : e.to} locale={locale} /></bdi>
                          ) : (
                            bit
                          ),
                        )}
                        {e.label && <small> (<BidiText text={e.label} locale={locale} />)</small>}
                      </li>
                    ))}
                  </ul>
                </details>
              )}
              {moreDiagrams.map((id, i) => (
                <FigurePanel locale={locale} id={id} n={i + 2} anchor={`fig-${id}`} approved={approved} />
              ))}
            </div>
          </section>

          <section class="cs-sec" id="outcome" aria-labelledby="h-outcome">
            <div class="cs-sec__rule">
              <span class="sec-head__index" dir="ltr">{num("outcome")}</span>
            </div>
            <h2 class="cs-sec__title" id="h-outcome">
              {m.work.labels.outcome}
            </h2>
            <div class="cs-prose">
              <ul class="ticks" role="list">
                {cs.outcome.map((f) => (
                  <li>
                    <span class="tick" aria-hidden="true">
                      <Icon name="check" />
                    </span>
                    <span>{tr(f.text, locale)}</span>
                  </li>
                ))}
              </ul>
            </div>
          </section>

          <section class="cs-sec" id="stack" aria-labelledby="h-stack">
            <div class="cs-sec__rule">
              <span class="sec-head__index" dir="ltr">{num("stack")}</span>
            </div>
            <h2 class="cs-sec__title" id="h-stack">
              {m.work.labels.stack}
            </h2>
            <div class="cs-prose">
              <dl class="stack-list wide">
                {stackGroups(cs).map((g) => (
                  <div class:list={["stack-list__row", accent(KIND_ACCENT[g.kind])]}>
                    <dt>
                      <i aria-hidden="true" />
                      {m.work.legend[g.kind]}
                    </dt>
                    <dd>
                      {g.items.map((t) => {
                        const a = techAccent(t);
                        return <span class:list={["chip", a !== "neutral" && `chip--${a}`]}>{stackLabel(t, locale)}</span>;
                      })}
                    </dd>
                  </div>
                ))}
              </dl>
              {cs.links.length === 0 && (
                <p class="sources">
                  <Icon name="info" />
                  <span>
                    <strong>{m.work.page.sourcesTitle}.</strong> {sources}
                  </span>
                </p>
              )}
            </div>
          </section>

          {cs.links.length > 0 && (
            <section class="cs-sec" id="links" aria-labelledby="h-links">
              <div class="cs-sec__rule">
                <span class="sec-head__index" dir="ltr">{num("links")}</span>
              </div>
              <h2 class="cs-sec__title" id="h-links">
                {m.work.page.links}
              </h2>
              <div class="cs-prose">
                <div class="cs-links">
                  {cs.links.map((l, i) => {
                    const href = byLocale(l.href as string | Record<Locale, string>, locale);
                    return (
                    <a class:list={["btn", i === 0 ? "btn--primary" : "btn--secondary"]} href={href} rel="noopener">
                      <Icon name={href.includes("github.com") ? "github" : "arrow-up-right"} />
                      {tr(l.label, locale)}
                      <span class="sr-only" dir="ltr">
                        ({href.replace(/^https:\/\//, "")})
                      </span>
                    </a>
                    );
                  })}
                </div>
                <p class="sources">
                  <Icon name="info" />
                  <span>
                    <strong>{m.work.page.sourcesTitle}.</strong> {sources}
                  </span>
                </p>
              </div>
            </section>
          )}
        </article>

        <Toc locale={locale} entries={toc} variant="rail" question={question} backHref={homeAnchor("work", locale, false)} />
      </div>
    )
  }

  {/* The enlarge view for this page's figures and screens (one dialog, shared). */}
  {(diagrams.length > 0 || (cs.screens?.length ?? 0) > 0) && <ZoomDialog locale={locale} />}

  <section class="section section--band cs-next" aria-labelledby="next-title">
    <div class="container">
      <h2 class="sr-only" id="next-title">{m.work.page.keepReading}</h2>
      <div class="cs-end">
        <NextCase locale={locale} cs={next} />
        <CaseCTA locale={locale} cs={cs} />
      </div>
    </div>
  </section>
</Base>

<script>
  // Paper has no disclosures: the ones marked data-print-open print open, and close again after.
  const printOpen = [...document.querySelectorAll<HTMLDetailsElement>("details[data-print-open]")];
  let reopen: HTMLDetailsElement[] = [];
  addEventListener("beforeprint", () => {
    reopen = printOpen.filter((d) => !d.open);
    for (const d of reopen) d.open = true;
  });
  addEventListener("afterprint", () => {
    for (const d of reopen) d.open = false;
    reopen = [];
  });

  // TOC: current section (aria-current) for the rail and the mobile bar, % read, and closing the mobile panel on
  // navigation; the rail steps aside while an in-article figure that breaks out over it passes (case.css). Plain links
  // work without this.
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
  const railBox = document.querySelector<HTMLElement>(".toc-rail__inner");
  const wideFigs = [...document.querySelectorAll<HTMLElement>(".cs-prose > .fig--dg")];
  const desk = matchMedia("(min-width: 64rem)");
  if (links.length) {
    const ids = [...new Set(links.map((a) => a.dataset.tocLink!))];
    const sections = ids.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
    const current = document.querySelector<HTMLElement>("[data-toc-current]");
    const pct = document.querySelector<HTMLElement>("[data-toc-pct]");
    const bar = document.querySelector<HTMLElement>("[data-toc-bar]");
    const mobile = document.querySelector<HTMLDetailsElement>("[data-toc-mobile]");
    const article = document.querySelector<HTMLElement>(".cs-article");
    let raf = 0;
    const update = () => {
      raf = 0;
      if (railBox && wideFigs.length) {
        const r = railBox.getBoundingClientRect();
        railBox.toggleAttribute(
          "data-covered",
          desk.matches &&
            wideFigs.some((f) => {
              const b = f.getBoundingClientRect();
              return b.top < r.bottom + 16 && b.bottom > r.top - 16;
            }),
        );
      }
      const line = innerHeight * 0.3;
      let active = sections[0];
      for (const s of sections) if (s.getBoundingClientRect().top <= line) active = s;
      for (const a of links) a.dataset.tocLink === active?.id ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current");
      if (current && active) current.textContent = links.find((a) => a.dataset.tocLink === active.id)?.textContent?.replace(/^\s*\d+\s*/, "").trim() ?? "";
      if (article) {
        const r = article.getBoundingClientRect();
        const total = r.height - innerHeight * 0.6;
        const p = Math.min(1, Math.max(0, (innerHeight * 0.4 - r.top) / Math.max(1, total)));
        if (pct) pct.textContent = `${Math.round(p * 100)}%`;
        bar?.style.setProperty("--p", String(p));
      }
    };
    addEventListener("scroll", () => (raf ||= requestAnimationFrame(update)), { passive: true });
    addEventListener("resize", update);
    update();
    mobile?.addEventListener("click", (e) => {
      if ((e.target as Element).closest("a")) mobile.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && mobile?.open) {
        mobile.open = false;
        mobile.querySelector("summary")?.focus();
      }
    });
  }
</script>
