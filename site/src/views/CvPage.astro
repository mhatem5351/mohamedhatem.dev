---
/**
 * /cv/ and /ar/cv/ (design/prototypes/cv.html): toolbar + A4 sheet, printable to two pages. The same page is rendered
 * to PDF after every build (scripts/postbuild/cv-pdf.mjs → public/cv/ and dist/cv/), so the PDF never drifts from it.
 */
import { existsSync, statSync } from "node:fs";
import { fileURLToPath } from "node:url";
import Document from "~/layouts/Document.astro";
import CvToolbar from "~/components/cv/CvToolbar.astro";
import CvSheet from "~/components/cv/CvSheet.astro";
import Ltr from "~/components/ui/Ltr.astro";
import "~/styles/cv.css";
import { format, formatMonth, messages, otherLocale, type Locale } from "~/lib/i18n";
import { CV_PDF, PATHS, profile } from "~/lib/site";
import { cvJsonLd } from "~/lib/jsonld";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages(locale);
const other = otherLocale(locale);

/** Size of the PDF generated by the previous build (the postbuild step regenerates it from this page). */
function pdfInfo(l: Locale): string | undefined {
  const file = fileURLToPath(new URL(`../../public${CV_PDF[l]}`, import.meta.url));
  if (!existsSync(file)) return undefined;
  const kb = Math.max(1, Math.round(statSync(file).size / 1024));
  return format(m.cv.fileInfo, { size: `${kb} KB` });
}
const fileInfo = pdfInfo(locale);
const updated = format(m.cv.updated, { date: formatMonth(profile.cv.updated, locale, "long") });
---
<Document
  locale={locale}
  title={m.meta.cv.title}
  description={m.meta.cv.description}
  path={PATHS.cv}
  ogKey="cv"
  ogType="profile"
  jsonLd={cvJsonLd(locale)}
  bodyClass="cv-page"
>
  <CvToolbar slot="bar" locale={locale} fileInfo={fileInfo} />
  <CvSheet locale={locale} />
  <p class="cv-after">
    <span>{updated}{fileInfo && <> · <Ltr>{fileInfo}</Ltr></>}</span>
    <a href={CV_PDF[other]} download={profile.cv.fileName[other]} hreflang={other} type="application/pdf">{m.cv.otherLanguagePdf}</a>
  </p>
</Document>
