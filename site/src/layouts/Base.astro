---
/**
 * Every page's shell: <head> (components/Head.astro), skip link, nav, <main>, footer, the phone action dock
 * (components/nav/ActionDock.astro), the live region and the chat mount.
 *
 * `path` is the page's English path ("/", "/cv/", "/work/<slug>/"); the Arabic twin is the same path under /ar/.
 */
import "~/styles/global.css";
import Nav from "~/components/nav/Nav.astro";
import Footer from "~/components/Footer.astro";
import ActionDock from "~/components/nav/ActionDock.astro";
import ChatMount from "~/components/chat/ChatMount.astro";
import Head from "~/components/Head.astro";
import { dirOf, messages, type Locale } from "~/lib/i18n";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** English path of this page (with trailing slash). */
  path: string;
  /** Path of the page in the other locale; null when there is no twin (the switch then goes to that locale's home). */
  alternatePath?: string | null;
  /** hreflang alternates + canonical (false for the 404 page). */
  indexable?: boolean;
  /** OG image key ("home", "cv", "privacy", "work-<slug>"). */
  ogKey?: string;
  /** Description of this page's sharing card (Head.astro). */
  ogImageAlt?: string;
  ogType?: "website" | "article" | "profile";
  /** article:* dates for ogType "article" (Head.astro). */
  article?: { published: string; modified: string };
  jsonLd?: readonly object[];
  bodyClass?: string;
  variant?: "full" | "minimal";
  /** Extra <link rel="preload"> for this page's LCP image, if any. */
  preload?: readonly { href: string; as: "image"; type?: string; imagesrcset?: string; imagesizes?: string }[];
}

const {
  locale,
  title,
  description,
  path,
  alternatePath,
  indexable = true,
  ogKey = "home",
  ogImageAlt,
  ogType = "website",
  article,
  jsonLd = [],
  bodyClass,
  variant = "full",
  preload = [],
} = Astro.props;

const m = messages(locale);
const dir = dirOf(locale);
---
<!doctype html>
<html lang={m.locale.code} dir={dir}>
  <head>
    <Head
      locale={locale}
      title={title}
      description={description}
      path={path}
      indexable={indexable}
      ogKey={ogKey}
      ogImageAlt={ogImageAlt}
      ogType={ogType}
      article={article}
      jsonLd={jsonLd}
      preload={preload}
    />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{m.a11y.skipToContent}</a>
    <Nav locale={locale} path={path} alternatePath={alternatePath} variant={variant} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} path={path} alternatePath={alternatePath} variant={variant} />
    {variant === "full" && <ActionDock locale={locale} />}
    <p id="live" class="sr-only" aria-live="polite"></p>
    {/* The 404 offers the assistant in its own actions: no launcher in its corner, no greeting (audit L-05, HM-12). */}
    <ChatMount locale={locale} greet={variant !== "minimal"} launcher={variant !== "minimal"} />
    <script>
      import "~/scripts/site";
    </script>
  </body>
</html>
