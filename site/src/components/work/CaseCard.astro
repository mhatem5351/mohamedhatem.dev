---
/**
 * A case-study card (DESIGN.md 12.10, prototype .work): 3 px accent bar, decorative media (diagram thumbnail, a
 * drawing from the architecture data, or the site screenshot for logic-controls.com), eyebrow
 * (company / role / years), title (a stretched link: the whole card is one link), summary, optional facts, stack chips,
 * an award badge where one belongs to the role, and the "Read the case study" cue. The company's logo tile sits
 * beside the eyebrow.
 *
 * A designed diagram moves while the card is on screen (src/scripts/motion.ts), with its pause button in the corner.
 *
 * Variants: "feature" (5/7 split, media on the end side), "wide" (feature layout, media on the start side),
 * "default" (grid card), "compact" (no media; the "More work" list). The eyebrow has one pattern everywhere,
 * "Company / years" (feature cards add the role); work dated only by a role shared with other case studies reads
 * "Wakeb Data / during 2024–2026", so the role's years don't pass for the project's own (audit FC-7).
 */
import type { CaseStudy } from "@content/profile.ts";
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import lcEn from "~/assets/showcase/lc-desktop-en-1440.webp";
import lcAr from "~/assets/showcase/lc-desktop-ar-1440.webp";
import Icon from "~/components/ui/Icon.astro";
import Ltr from "~/components/ui/Ltr.astro";
import ArchThumb from "~/components/work/ArchThumb.astro";
import LogoTile from "~/components/ui/LogoTile.astro";
import MotionToggle from "~/components/ui/MotionToggle.astro";
import { CASE_DIAGRAMS, diagramSvg } from "~/lib/diagrams";
import { formatYears, localePath, messages, type Locale } from "~/lib/i18n";
import { caseLogo, companyOf, sharesRolePeriod } from "~/lib/case";
import { PATHS, profile } from "~/lib/site";
import { CASE_ACCENT } from "~/lib/home-work";
import { noBreakHtml } from "~/lib/nobreak";

interface Props {
  cs: CaseStudy;
  locale: Locale;
  variant?: "feature" | "wide" | "default" | "compact";
  /** data-reveal stagger index (0-5). */
  i?: number;
  headingLevel?: 3 | 4;
  class?: string;
  /** Anchor id on the card (the logic-controls.com card keeps the old home "#craft" anchor). */
  id?: string;
}
const { cs, locale, variant = "default", i = 0, headingLevel = 3, class: className, id } = Astro.props;
const m = messages(locale);
const role = cs.roleId ? profile.experience.find((r) => r.id === cs.roleId) : undefined;
const honors = role ? profile.honors.filter((h) => h.roleId === role.id) : [];
const href = localePath(PATHS.work(cs.slug), locale);
const diagramId = CASE_DIAGRAMS[cs.slug]?.[0];
/**
 * No designed diagram but approved product screens (Al Majed Oud): the first desktop screen in the small browser frame,
 * like the logic-controls.com site, instead of a drawing squeezed from a large architecture (13 parts read as clutter
 * at thumbnail size).
 */
const screenFiles = import.meta.glob<{ default: ImageMetadata }>("../../assets/screens/*/*.webp", { eager: true });
const firstScreen = diagramId ? undefined : cs.screens?.find((sc) => sc.frame === "desktop");
const screenImg = firstScreen ? screenFiles[`../../assets/screens/${cs.slug}/${firstScreen.file}`]?.default : undefined;
const big = variant === "feature" || variant === "wide";
const facts = big ? cs.outcome.slice(0, 3) : [];
const chips = cs.stack.slice(0, big ? 5 : 4);
const company = role ? role.company[locale] : null;
/**
 * Contract or freelance work outside the experience list: a named client (`client`, Al Majed Oud) leads the eyebrow
 * like an employer, with "Freelance" in the role slot of the big cards; the freelance site (no `client` entry) keeps
 * "Freelance" first and its client, Logic Controls, in the role slot.
 */
const client = role ? null : companyOf(cs, locale);
const org = company ?? (cs.client ? client : null);
const years = formatYears(cs.period);
/** "during 2024–2026" for work dated only by a shared role; split around {years} so the range stays isolated. */
const yearsParts = company && sharesRolePeriod(cs) ? m.work.page.atRole.split(/(\{years\})/).filter(Boolean) : ["{years}"];
const Heading = headingLevel === 3 ? "h3" : "h4";
const lc = locale === "ar" ? lcAr : lcEn;
/**
 * Titles never break inside a hyphenated compound ("self-hosted", "real-estate", "6-agent"), a number range or a domain
 * name ("logic-controls.com", with its trailing punctuation): each becomes an unbreakable unit (audit VUX-05, H-02),
 * with the site's shared helper (lib/nobreak.ts).
 */
const title = noBreakHtml(cs.title[locale], "nowrap");
const brief = cs.depth === "brief";
/** The company's tile beside the eyebrow: the employer's (the government assistant shows Wakeb Data, never its client);
 * contract or freelance work shows its client's (Al Majed Oud, Logic Controls). Decorative: the eyebrow names the company. */
const logo = caseLogo(cs);
const isLatin = (t: string) => !/[\u0600-\u06FF]/.test(t);
---
<article
  id={id}
  class:list={[
    "card card--link work",
    `accent-${CASE_ACCENT[cs.slug]}`,
    big && "work--feature",
    variant === "wide" && "work--reverse",
    variant === "compact" && "work--compact",
    className,
  ]}
  data-reveal
  data-reveal-i={i ? String(i) : undefined}
>
  {
    variant !== "compact" && (
      <div class:list={["work__media", !diagramId && (cs.slug === "logic-controls-website" || screenImg) && "work__media--shot"]} dir="ltr" data-motion={diagramId ? "dg-play" : undefined}>
        {diagramId ? (
          <>
            <Fragment set:html={diagramSvg(diagramId, "thumb", { locale, decorative: true, idSuffix: `card-${cs.slug}` })} />
            <MotionToggle locale={locale} variant="corner" />
          </>
        ) : cs.slug === "logic-controls-website" ? (
          <div class="mini-browser" aria-hidden="true">
            <span class="mini-browser__bar">
              <i />
              <i />
              <i />
            </span>
            <Picture src={lc} formats={["avif", "webp"]} widths={[480, 720, 960]} sizes={big ? "(min-width: 64rem) 40rem, calc(100vw - 5rem)" : "(min-width: 64rem) 24rem, (min-width: 48rem) calc(50vw - 4rem), calc(100vw - 5rem)"} alt="" loading="lazy" decoding="async" />
          </div>
        ) : screenImg ? (
          <div class="mini-browser mini-browser--screen" aria-hidden="true">
            <span class="mini-browser__bar">
              <i />
              <i />
              <i />
            </span>
            <Picture src={screenImg} formats={["avif", "webp"]} widths={[480, 720, 960]} sizes={big ? "(min-width: 64rem) 40rem, calc(100vw - 5rem)" : "(min-width: 64rem) 24rem, (min-width: 48rem) calc(50vw - 4rem), calc(100vw - 5rem)"} alt="" loading="lazy" decoding="async" />
          </div>
        ) : (
          <ArchThumb cs={cs} />
        )}
      </div>
    )
  }
  <div class="work__body">
    <div class="work__meta">
      <LogoTile file={logo.file} monogram={logo.monogram} size={big ? 28 : 24} class="work__logo" />
      {/* Company / role / years as a separator list: a "/" never ends a line or starts one (audit H-07). */}
      <span class="eyebrow sep-list sep-list--slash">
        <span class="sep-list__in">
          {/* Every Latin part is set the same way (lang + .latin), "Freelance" included, so a freelance card's eyebrow has
              its neighbours' line box and the row's eyebrows line up to the pixel. */}
          {[org ?? m.work.freelance].map((t) => (isLatin(t) ? <span lang="en" class="latin">{t}</span> : <span>{t}</span>))}
          {big && (role ? <span>{role.title[locale]}</span> : cs.client ? <span>{m.work.freelance}</span> : client && (isLatin(client) ? <span lang="en" class="latin">{client}</span> : <span>{client}</span>))}
          <span>{yearsParts.map((part) => (part === "{years}" ? <Ltr>{years}</Ltr> : part))}</span>
        </span>
      </span>
    </div>
    <Heading class="work__title"><a class="stretched" href={href} set:html={title} /></Heading>
    {/* Copy keeps its compounds, domains and ranges whole too ("6-agent", "logic-controls.com", "98–100"; R7-HOME-03). */}
    <p class="work__summary" set:html={noBreakHtml(cs.summary[locale], "nowrap")} />
    {
      facts.length > 0 && (
        <ul class="work__facts">
          {facts.map((f) => (
            <li>
              <span set:html={noBreakHtml(f.text[locale], "nowrap")} />
            </li>
          ))}
        </ul>
      )
    }
    <div class="work__foot">
      {
        variant !== "compact" && (
          <ul class="cluster gap-tight chips" role="list" aria-label={m.work.labels.stack}>
            {chips.map((s) => (
              <li class="chip" lang="en">
                {s}
              </li>
            ))}
            {honors.map((h) => (
              <li class="badge">
                <Icon name="award" />
                {h.title[locale]}
              </li>
            ))}
          </ul>
        )
      }
      <span class="work__cta" aria-hidden="true">{brief ? m.work.readBrief : m.work.readCase}<Icon name="arrow-right" size="sm" /></span>
    </div>
  </div>
</article>

<style>
  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .work__foot {
    margin-block-start: auto;
    align-self: end;
  }
  .work__body {
    align-content: start;
  }
  /* logic-controls.com and the product screens (Al Majed Oud): a framed screenshot instead of a diagram. */
  .work__media--shot {
    --media-pad: 1.25rem;
  }
  .mini-browser {
    width: 100%;
    height: auto;
    max-width: 36rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 0.625rem;
    background: var(--color-surface);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  .mini-browser__bar {
    display: flex;
    gap: 0.3rem;
    padding: 0.45rem 0.6rem;
    border-block-end: 1px solid var(--color-line);
    background: var(--color-surface-2);
  }
  .mini-browser__bar i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-line-strong);
  }
  .mini-browser :global(img) {
    width: 100%;
    height: auto;
    /* The capture ends above the client site's angled divider (1440 × 828). */
    aspect-ratio: 1440 / 828;
    object-fit: cover;
    object-position: top;
  }
  /* A product screen fills the 16 : 10 media box (its top shown, the bottom cropped by the frame), and never sizes the
     box itself: content taller than an aspect-ratio box would grow it and push this card's eyebrow below its row's. */
  .mini-browser--screen {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .mini-browser--screen :global(picture) {
    display: block;
    flex: 1 1 0;
    min-height: 0;
  }
  .mini-browser--screen :global(img) {
    height: 100%;
    aspect-ratio: auto;
  }
  @media (min-width: 64rem) {
    .work--reverse {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    /* Up to 80rem the wide card's row is shared evenly: its body column then holds a domain title on one line. */
    @media (max-width: 79.99rem) {
      .work--reverse {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      }
    }
    .work--reverse .work__media {
      order: 0;
      border-inline-start: 0;
      border-inline-end: 1px solid var(--color-line);
    }
    .work--feature .work__media--shot {
      --media-pad: 2.5rem;
    }
  }
  .work--compact .work__title {
    font-size: var(--text-lg);
    line-height: var(--text-lg--line-height);
    letter-spacing: var(--text-lg--letter-spacing);
  }
  .work--compact .work__summary {
    font-size: var(--text-sm);
  }
</style>
