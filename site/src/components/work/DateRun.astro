---
/**
 * A date or period inside possibly-Arabic text (HANDOFF.md 6.3): purely numeric runs ("2023–2024", "Aug 2022" on
 * English pages) are isolated LTR so the Arabic bidi algorithm can't reverse them; runs with Arabic month names
 * ("سبتمبر 2024 – أبريل 2026") are isolated with their natural, right-to-left direction, and a year range inside them
 * ("سبتمبر 2023 – 2027 (متوقع)") is isolated LTR again, so it reads "2023 – 2027" as everywhere else (DESIGN 4.3,
 * audit A-02).
 */
import BidiText from "~/components/ui/BidiText.astro";

interface Props {
  text: string;
  class?: string;
}
const { text, class: className } = Astro.props;
const arabic = /[؀-ۿ]/.test(text);
---
{arabic ? <bdi dir="rtl" class={className}><BidiText text={text} locale="ar" /></bdi> : <bdi dir="ltr" class={className}>{text}</bdi>}
