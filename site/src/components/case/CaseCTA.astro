---
/**
 * Dark CTA band at the end of a case study (pages.css §11): ask the assistant about this project (the ask bar shows
 * the exact question it sends), contact on the home page, or email.
 */
import Icon from "~/components/ui/Icon.astro";
import Ltr from "~/components/ui/Ltr.astro";
import type { CaseStudy } from "@content/profile.ts";
import { format, messages, tr, type Locale } from "~/lib/i18n";
import { contact, homeAnchor, mailtoHref } from "~/lib/site";
import { askQuestion } from "~/lib/case";

interface Props {
  locale: Locale;
  cs: CaseStudy;
}
const { locale, cs } = Astro.props;
const m = messages(locale);
const q = askQuestion(cs, locale);
const email = contact("email").display;
---
<div class="cta-band">
  <p class="eyebrow">{m.work.page.ctaEyebrow}</p>
  <h3 class="cta-band__title">{format(m.work.page.ctaTitle, { title: tr(cs.shortTitle, locale) })}</h3>
  <p class="cta-band__text">{m.work.page.ctaBody}</p>
  <button class="ask-bar" type="button" data-open-chat data-question={q} aria-haspopup="dialog">
    <Icon name="ask" size="md" class="ask-bar__icon" />
    <span class="ask-bar__text">{q}</span>
    <span class="ask-bar__go" aria-hidden="true"><Icon name="arrow-right" /></span>
  </button>
  <div class="cta-band__row">
    <a class="btn btn--sm btn--onInverse" href={homeAnchor("contact", locale, false)}>
      <Icon name="mail" />
      {m.work.page.ctaContact}
    </a>
    <span class="cta-band__mail">
      {m.work.page.ctaWrite}{" "}<a href={mailtoHref(locale)}><Ltr>{email}</Ltr></a>
    </span>
  </div>
</div>
