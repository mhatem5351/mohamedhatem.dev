---
/**
 * A designed architecture diagram (pages.css §4): framed panel with a mono title bar, the SVG inlined twice (wide and
 * compact; a container query shows one, the hidden one is display:none and so out of the accessibility tree), then
 * the caption, the architecture disclaimer, the numbered callouts (numbers match the drawing) and the long text
 * description. Diagrams stay LTR on Arabic pages; their title/desc, caption and callouts are Arabic there. The drawing
 * moves while on screen (a request travelling its main path, src/scripts/motion.ts); its pause button sits in the bar.
 *
 * Phones (audit CASE-01, CASE-02):
 * - "Enlarge" (the bar's expand button, 44 px on touch screens) opens the wide drawing in the page's enlarge view
 *   (ZoomDialog.astro): full screen at its design size to pan and pinch-zoom; Back, Escape or × close it. The drawing
 *   for it waits in a <template> (its own ids), so nothing is duplicated in the page until it opens. With JS only.
 * - The first figure (`fig--hero`) is shown cut at about two-thirds of the screen with a fade and "Show the full
 *   diagram", so the story isn't pushed three screens down; the callouts and the text description come with the full
 *   diagram. Without JS the figure is shown whole.
 */
import Icon from "~/components/ui/Icon.astro";
import BidiText from "~/components/ui/BidiText.astro";
import MotionToggle from "~/components/ui/MotionToggle.astro";
import { diagram, diagramSvg, type DiagramId } from "~/lib/diagrams";
import { dirOf, format, messages, type Locale } from "~/lib/i18n";

interface Props {
  locale: Locale;
  id: DiagramId;
  n: number;
  /** id of the <figure> (anchor target) */
  anchor?: string;
  class?: string;
  /** The drawing shows parts approved for publication (HM-19): its note says so where the copy has that line. */
  approved?: boolean;
}
const { locale, id, n, anchor, class: className, approved = false } = Astro.props;
const m = messages(locale);
const d = diagram(id);
const figLabel = format(m.work.page.figure, { n });
const capId = `${anchor ?? id}-cap`;
const wide = diagramSvg(id, "wide", { locale });
const compact = diagramSvg(id, "compact", { locale });
/** The enlarge view's copy: the wide drawing with its own ids (it is cloned into the dialog only when opened). */
const zoomed = diagramSvg(id, "wide", { locale, idSuffix: "zoom" });
const hero = (className ?? "").split(/\s+/).includes("fig--hero");
const enlarge = format(m.work.page.enlargeFigure, { n });
/** The bar names the figure in the page's language (audits C-31, A-22): "Fig. 1" / "الشكل 1", the system's short
 * title (the diagram title up to its colon) and the kind, "Architecture", like the generated component views. */
const barId = locale === "ar" ? figLabel : `Fig. ${n}`;
const barTitle = d.title[locale].split(/[:：]/)[0]!.trim();
const approvedNote = (m.work as { architectureNoteApproved?: string }).architectureNoteApproved;
const note = approved && approvedNote ? approvedNote : m.work.architectureNote;
---
<figure class:list={["fig", "fig--dg", className]} id={anchor} aria-labelledby={capId}>
  <div class="fig-panel">
    <div class="fig-panel__bar">
      <span class="fig-panel__id">{barId}</span>
      <span class="fig-panel__title"><BidiText text={barTitle} locale={locale} /></span>
      <span class="fig-panel__kind">{m.work.labels.architecture}</span>
      <button
        class="fig-panel__zoom"
        type="button"
        data-zoom-figure
        data-caption={`${figLabel}. ${d.title[locale]}`}
        aria-label={enlarge}
        title={enlarge}
        aria-haspopup="dialog"
      >
        <Icon name="expand" />
      </button>
      <MotionToggle locale={locale} />
    </div>
    <div class="fig-panel__canvas" dir="ltr" data-motion="dg-play">
      <div class="dg-variant dg-variant--wide" set:html={wide} />
      <div class="dg-variant dg-variant--compact" set:html={compact} />
      {
        hero && (
          <button class="btn btn--secondary fig-panel__more" type="button" dir={dirOf(locale)} data-fig-more data-chat-avoid>
            {m.work.page.showFullDiagram}
            <Icon name="chevron-down" />
          </button>
        )
      }
    </div>
    <template data-zoom-src><Fragment set:html={zoomed} /></template>
  </div>
  <figcaption class="fig__caption">
    <p class="fig__caption-text" id={capId}>
      <b>{figLabel}</b>
      {" "}<BidiText text={d.caption[locale]} locale={locale} />
      <span class="fig__note">{note}</span>
    </p>
    <ol class:list={["callouts", d.callouts.length > 4 && "callouts--3"]} aria-label={m.work.page.components}>
      {
        d.callouts.map((c) => (
          <li>
            <span class="co" aria-hidden="true">
              {c.n}
            </span>
            <span>
              {c.term && <b><BidiText text={c.term[locale]} locale={locale} />.</b>}
              {c.term && " "}
              <BidiText text={c[locale]} locale={locale} />
            </span>
          </li>
        ))
      }
    </ol>
    <details class="fig__desc">
      <summary>
        {m.work.page.textDescription}
        <Icon name="chevron-down" size="sm" />
      </summary>
      <p><BidiText text={d.desc.long[locale]} locale={locale} /></p>
    </details>
  </figcaption>
</figure>
{
  hero && (
    <script>
      // "Show the full diagram": the first figure is cut on phones (case.css); this shows all of it and moves focus to
      // its caption (the button is gone), so the reader continues from there.
      for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-fig-more]")) {
        btn.addEventListener("click", () => {
          const fig = btn.closest<HTMLElement>("figure");
          if (!fig) return;
          fig.toggleAttribute("data-open", true);
          const cap = fig.querySelector<HTMLElement>(".fig__caption-text");
          if (cap) {
            cap.tabIndex = -1;
            cap.focus({ preventScroll: true });
          }
        });
      }
    </script>
  )
}
<script>
  // The numbered notes and the drawing point at each other (audit C-50): resting the pointer on a note (or tapping it)
  // lights its part of the drawing and dims the rest; resting it on a disc in the drawing lights its note. The disc's
  // part is found by geometry (a node disc sits on its node's top edge, a group disc on its group's tab), so it follows
  // any layout the diagram build makes. A state change only, no motion.
  type Hit = { svg: SVGSVGElement; on: Element[] };
  const near = (b: DOMRect | SVGRect, x: number, y: number, pad: number) => x >= b.x - pad && x <= b.x + b.width + pad && y >= b.y - pad && y <= b.y + b.height + pad;
  /** The disc numbered `n` in the drawing on screen, and what it annotates. */
  function partsOf(fig: HTMLElement, n: string): Hit | null {
    const svg = [...fig.querySelectorAll<SVGSVGElement>(".dg-variant > svg")].find((s) => s.getClientRects().length);
    if (!svg) return null;
    const disc = [...svg.querySelectorAll<SVGGElement>(".dg-co")].find((g) => !g.closest(".dg-legend") && g.textContent?.trim() === n);
    const c = disc?.querySelector("circle");
    if (!disc || !c) return null;
    const x = c.cx.baseVal.value;
    const y = c.cy.baseVal.value;
    const area = (b: SVGRect) => b.width * b.height;
    const nodes = [...svg.querySelectorAll<SVGGElement>(".dg-n")].map((g) => ({ g, b: g.getBBox() })).filter((o) => near(o.b, x, y, 12));
    if (nodes.length) {
      nodes.sort((a, b) => area(a.b) - area(b.b));
      return { svg, on: [disc, nodes[0]!.g] };
    }
    const groups = [...svg.querySelectorAll<SVGRectElement>(".dg-grp")].map((r) => ({ r, b: r.getBBox() })).filter((o) => near(o.b, x, y, 14));
    if (!groups.length) return { svg, on: [disc] };
    groups.sort((a, b) => area(a.b) - area(b.b));
    const gb = groups[0]!.b;
    // The group, its tab and every node inside it.
    const inside = [...svg.querySelectorAll<SVGGElement>(".dg-n")].filter((g) => {
      const b = g.getBBox();
      return near(gb, b.x + b.width / 2, b.y + b.height / 2, 0);
    });
    const tabs = [...svg.querySelectorAll<SVGElement>(".dg-tab, .dg-tabbg")].filter((t) => {
      const b = (t as SVGGraphicsElement).getBBox();
      return near(gb, b.x + b.width / 2, b.y + b.height / 2, 14);
    });
    return { svg, on: [disc, groups[0]!.r, ...tabs, ...inside] };
  }
  let lit: { hit: Hit; li: HTMLElement } | null = null;
  function clear(): void {
    if (!lit) return;
    lit.hit.svg.classList.remove("dg-focus");
    for (const el of lit.hit.on) el.classList.remove("dg-on");
    lit.li.classList.remove("is-on");
    lit = null;
  }
  function light(fig: HTMLElement, li: HTMLElement): void {
    const n = li.querySelector(".co")?.textContent?.trim();
    if (!n) return;
    if (lit?.li === li) return;
    clear();
    const hit = partsOf(fig, n);
    if (!hit) return;
    hit.svg.classList.add("dg-focus");
    for (const el of hit.on) el.classList.add("dg-on");
    li.classList.add("is-on");
    lit = { hit, li };
  }
  for (const fig of document.querySelectorAll<HTMLElement>("figure.fig--dg")) {
    const items = [...fig.querySelectorAll<HTMLElement>(".callouts > li")];
    for (const li of items) {
      li.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && light(fig, li));
      li.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && lit?.li === li && clear());
      // Touch: a tap on a note lights it until the next tap.
      li.addEventListener("click", (e) => {
        if ((e as PointerEvent).pointerType === "mouse") return;
        if (lit?.li === li) clear();
        else light(fig, li);
      });
    }
    fig.addEventListener("pointerover", (e) => {
      if (e.pointerType !== "mouse") return;
      const disc = (e.target as Element).closest?.(".dg-co");
      if (!disc || disc.closest(".dg-legend")) return;
      const li = items.find((l) => l.querySelector(".co")?.textContent?.trim() === disc.textContent?.trim());
      if (li) light(fig, li);
    });
    fig.addEventListener("pointerout", (e) => {
      if (e.pointerType !== "mouse" || !lit) return;
      const from = (e.target as Element).closest?.(".dg-co");
      if (from && !from.contains(e.relatedTarget as Node)) clear();
    });
  }
</script>
