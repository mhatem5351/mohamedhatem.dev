---
/**
 * Back button + breadcrumb trail "Work / <short title>" (pages.css §1). The BreadcrumbList JSON-LD is in lib/jsonld.ts.
 * The current title goes through BidiText: in Arabic each Latin name ("Empoweromics", "logic-controls.com") is its own
 * isolate, which case.css keeps whole, so a long title loses a whole name to its ellipsis, never the start of one
 * (audit R7-AR-04).
 */
import Icon from "~/components/ui/Icon.astro";
import BidiText from "~/components/ui/BidiText.astro";
import { messages, type Locale } from "~/lib/i18n";
import { homeAnchor } from "~/lib/site";

interface Props {
  locale: Locale;
  current: string;
}
const { locale, current } = Astro.props;
const m = messages(locale);
const back = homeAnchor("work", locale, false);
---
<div class="crumbs-row">
  <a class="back-btn" href={back} aria-label={m.work.page.backToWork} title={m.work.page.backToWork}>
    <Icon name="arrow-left" />
  </a>
  <nav class="crumbs" aria-label={m.a11y.breadcrumb}>
    <ol>
      <li><a href={back}>{m.nav.work}</a></li>
      <li><span aria-current="page"><BidiText text={current} locale={locale} /></span></li>
    </ol>
  </nav>
</div>
