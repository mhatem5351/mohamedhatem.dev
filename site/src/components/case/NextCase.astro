---
/**
 * The next case study in display order (pages.css §11): one card, whole card is a link (stretched title anchor),
 * with the next system's decorative diagram thumbnail (or, for logic-controls.com, its desktop screenshot).
 */
import { Image } from "astro:assets";
import Icon from "~/components/ui/Icon.astro";
import Ltr from "~/components/ui/Ltr.astro";
import type { CaseStudy } from "@content/profile.ts";
import { diagramSvg } from "~/lib/diagrams";
import { localePath, messages, tr, type Locale } from "~/lib/i18n";
import { PATHS } from "~/lib/site";
import { accentOf, diagramsOf, eyebrowParts } from "~/lib/case";
import lcDesktopEn from "~/assets/showcase/lc-desktop-en-960.webp";
import lcDesktopAr from "~/assets/showcase/lc-desktop-ar-960.webp";

interface Props {
  locale: Locale;
  cs: CaseStudy;
}
const { locale, cs } = Astro.props;
const m = messages(locale);
const eb = eyebrowParts(cs, locale);
const thumb = diagramsOf(cs)[0];
const svg = thumb ? diagramSvg(thumb, "thumb", { decorative: true, idSuffix: "next" }) : undefined;
const shot = cs.slug === "logic-controls-website" ? (locale === "ar" ? lcDesktopAr : lcDesktopEn) : undefined;
const isLatin = (s: string) => !/[؀-ۿ]/.test(s);
---
<article class:list={["card card--link work next-case", `accent-${accentOf(cs)}`, !(svg || shot) && "next-case--plain"]}>
  {
    (svg || shot) && (
      <div class="work__media" aria-hidden="true">
        {svg ? <Fragment set:html={svg} /> : shot && <Image src={shot} alt="" width={480} widths={[480, 960]} sizes="(min-width: 64rem) 22rem, 100vw" loading="lazy" />}
      </div>
    )
  }
  <div class="work__body">
    <div class="next-case__label">
      <span class="eyebrow">{m.work.nextCase}</span>
      <span class="next-case__arrow" aria-hidden="true"><Icon name="arrow-right" size="sm" /></span>
    </div>
    <span class="eyebrow eyebrow--ink">
      {isLatin(eb.company) ? <span lang="en">{eb.company}</span> : eb.company}<span class="sep" aria-hidden="true">/</span><Ltr>{eb.years}</Ltr>
    </span>
    <h3 class="work__title"><a class="stretched" href={localePath(PATHS.work(cs.slug), locale)}>{tr(cs.title, locale)}</a></h3>
    <p class="work__summary">{tr(cs.summary, locale)}</p>
    <ul class="cluster gap-tight" role="list">
      {cs.stack.slice(0, 5).map((t) => <li class="chip">{t}</li>)}
    </ul>
  </div>
</article>
