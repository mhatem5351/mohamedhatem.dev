---
/**
 * Case-study hero (pages.css §2–3): breadcrumbs, eyebrow (the organisation's logo tile, then organisation / role /
 * years), H1, summary, actions,
 * the CaseMeta card (role, organisation, period + duration, where, stack) and the key-facts strip
 * (case.figures: 2–4 sourced facts, never estimated; omitted below 2, where one cell would only restate the summary).
 * The strip keeps four columns from 64rem, so two or three facts don't stretch across the page. The figure slot
 * renders below the facts.
 */
import Breadcrumbs from "./Breadcrumbs.astro";
import Icon from "~/components/ui/Icon.astro";
import LogoTile from "~/components/ui/LogoTile.astro";
import Ltr from "~/components/ui/Ltr.astro";
import BidiText from "~/components/ui/BidiText.astro";
import type { CaseStudy } from "@content/profile.ts";
import { messages, tr, type Locale } from "~/lib/i18n";
import { byLocale, profile } from "~/lib/site";
import { noBreakHtml } from "~/lib/nobreak";
import { bidiUnits } from "~/lib/bidi";
import { askQuestion, caseLogo, contextDetail, eyebrowParts, periodInfo, roleOf, stackLabel, techAccent } from "~/lib/case";

interface Props {
  locale: Locale;
  cs: CaseStudy;
  /** id of the architecture figure for "See the architecture" (absent: no such link, e.g. a brief page with no figure). */
  figureId?: string | undefined;
}
const { locale, cs, figureId } = Astro.props;
const m = messages(locale);
const role = roleOf(cs);
const eb = eyebrowParts(cs, locale);
const period = periodInfo(cs, locale);
// The same tile as the work cards: the employer's for work in a role, the client's own for contract or freelance work
// (Al Majed Oud; Logic Controls for the freelance site).
const logo = caseLogo(cs);
const detail = contextDetail(cs, locale);
const isLatin = (s: string) => !/[؀-ۿ]/.test(s);
const employment = role ? m.experience.employmentType[role.employmentType] : m.work.freelance;
const mode = role?.workMode ? m.experience.workMode[role.workMode] : undefined;
const figures = cs.figures.length >= 2 ? cs.figures.slice(0, 4) : [];
/** A date range with each end unbreakable ("Sep 2024" / "سبتمبر 2024" never splits from its year; C-18, A-20). */
const dateUnits = (text: string) => text.split(/(\s+[–—-]\s+)/);
const question = askQuestion(cs, locale);
/** A short Latin name in an Arabic title or summary ("Cloudflare Workers") never splits at its space (A-20). */
const glue = (t: string) => bidiUnits(t, locale).map((u) => u.text).join("");
/** A title with a domain in it ("logic-controls.com: …") steps down on small phones, so the domain fits one line (C-02). */
/** Awards of this role (R7-26): a badge on the role row, as on the work cards. */
const honors = role ? profile.honors.filter((h) => h.roleId === role.id) : [];
const domainTitle = /\b[a-z0-9-]+\.(?:com|dev|org|net|io)\b/.test(tr(cs.title, locale));
/** A short role ("AI Engineer", "Data Scientist") moves to the next line whole; a long one wraps word by word (C-36). */
const shortRole = eb.role.trim().split(/\s+/).length <= 2 || eb.role.length <= 18;
---
<section class:list={["cs-hero", cs.depth === "brief" && "cs-hero--brief"]} aria-labelledby="cs-title">
  <div class="cs-hero__bg" aria-hidden="true"></div>
  <div class="container">
    <Breadcrumbs locale={locale} current={tr(cs.shortTitle, locale)} />

    <div class="cs-hero__grid">
      <div class="cs-hero__copy">
        <p class="eyebrow">
          <LogoTile file={logo.file} monogram={logo.monogram} size={32} class="cs-hero__logo" loading="eager" />
          <span class="cs-hero__line">
            <span class="cs-hero__unit">{isLatin(eb.company) ? <span lang="en">{eb.company}</span> : <span>{eb.company}</span>}&nbsp;<span class="sep" aria-hidden="true">/</span></span>
            <span class:list={[shortRole && "cs-hero__unit"]}>{eb.role}&nbsp;<span class="sep" aria-hidden="true">/</span></span>
            <span class="cs-hero__unit"><Ltr>{eb.years}</Ltr></span>
            {cs.depth === "brief" && <span class="cs-hero__brief">{m.work.page.briefTag}</span>}
          </span>
        </p>
        <h1 class:list={["cs-hero__title", domainTitle && "cs-hero__title--domain"]} id="cs-title" set:html={noBreakHtml(glue(tr(cs.title, locale)))} />
        <p class="cs-hero__summary" set:html={noBreakHtml(glue(tr(cs.summary, locale)))} />
        {/* On phones the chat launcher and the action dock wait until these actions have scrolled past (site.ts,
            dock.ts): the hero already offers the assistant, so the launcher never sits on the hero's text (R7-LEAD-02). */}
        <div class="cs-hero__actions" data-dock-after data-chat-after>
          <button class="btn btn--secondary" type="button" data-open-chat data-question={question} aria-haspopup="dialog" data-chat-avoid>
            <Icon name="ask" />
            {m.work.page.ask}
          </button>
          {
            figureId && (
              <a class="btn btn--ghost" href={`#${figureId}`}>
                {m.work.page.seeArchitecture}
                <Icon name="arrow-down" class="arrow" />
              </a>
            )
          }
          {
            cs.links.map((l) => {
              // A link may be one URL or one per language (SEO-04).
              const href = byLocale(l.href as string | Record<Locale, string>, locale);
              return (
              <a class="btn btn--ghost" href={href} rel="noopener">
                <Icon name={href.includes("github.com") ? "github" : "arrow-up-right"} />
                {tr(l.label, locale)}
              </a>
              );
            })
          }
        </div>
      </div>

      <dl class="card cs-meta">
        <div class="cs-meta__row">
          <dt>{m.work.page.role}</dt>
          <dd>
            <BidiText text={tr(cs.contribution, locale)} locale={locale} />
            <small>{[employment, mode].filter(Boolean).join(locale === "ar" ? "، " : ", ")}</small>
            {honors.map((h) => (
              <span class="badge cs-meta__award">
                <Icon name="award" />
                <BidiText text={h.title[locale]} locale={locale} />
              </span>
            ))}
          </dd>
        </div>
        <div class="cs-meta__row">
          <dt>{m.work.page.company}</dt>
          <dd>
            {/* Text only: the eyebrow above already leads with the organisation's logo tile (C-19). */}
            <span class="cs-meta__org">{isLatin(eb.company) ? <span lang="en">{eb.company}</span> : <BidiText text={eb.company} locale={locale} />}</span>
            {detail && <small><BidiText text={detail} locale={locale} /></small>}
          </dd>
        </div>
        <div class="cs-meta__row">
          <dt>{m.work.labels.period}</dt>
          <dd>
            {period.isRolePeriod ? <BidiText text={period.main} locale={locale} /> : <Ltr>{dateUnits(period.main).map((p, i) => (i % 2 ? p : <span class="cs-meta__date">{p}</span>))}</Ltr>}
            {period.small && <small>{period.isRolePeriod ? <Ltr>{dateUnits(period.small).map((p, i) => (i % 2 ? p : <span class="cs-meta__date">{p}</span>))}</Ltr> : period.small}</small>}
          </dd>
        </div>
        {
          role && (
            <div class="cs-meta__row">
              <dt>{m.work.page.location}</dt>
              <dd><BidiText text={tr(role.location, locale)} locale={locale} /></dd>
            </div>
          )
        }
        <div class="cs-meta__row">
          <dt>{m.work.labels.stack}</dt>
          <dd>
            <ul class="cluster" role="list">
              {cs.stack.slice(0, 7).map((t) => {
                const a = techAccent(t);
                return <li class:list={["chip", a !== "neutral" && `chip--${a}`]}>{stackLabel(t, locale)}</li>;
              })}
            </ul>
          </dd>
        </div>
      </dl>
    </div>

    {
      figures.length > 0 && (
        <dl class:list={["metrics", "cs-facts", `cs-facts--${figures.length}`]}>
          {figures.map((f) => (
            <div class="metric">
              <dt class="metric__label">{tr(f.label, locale)}</dt>
              <dd class:list={["metric__value", !/\d/.test(tr(f.value, locale)) && "metric__value--word"]}>
                {isLatin(tr(f.value, locale)) ? <Ltr>{tr(f.value, locale)}</Ltr> : tr(f.value, locale)}
                {f.unit && <small>{tr(f.unit, locale)}</small>}
              </dd>
            </div>
          ))}
        </dl>
      )
    }

    <slot />
  </div>
</section>
