---
/**
 * Every page's <head> (used by layouts/Base.astro and layouts/Document.astro): meta, theme boot script, canonical +
 * hreflang (en, ar, x-default), self-hosted fonts with the right preloads, icons + manifest, Open Graph / Twitter,
 * JSON-LD and the Cloudflare Web Analytics beacon (production builds only; token from the repo's .env).
 *
 * The CSP <meta> is added by Astro (astro.config.mjs → security.csp) and completed with this page's inline-script
 * and inline-style hashes by integrations/csp-hashes.mjs; nothing here may use style="" attributes.
 */
import { Font } from "astro:assets";
import { localePath, messages, otherLocale, type Locale } from "~/lib/i18n";
import { absolute, ogImage as ogPath } from "~/lib/site";
import { analyticsToken } from "~/lib/env";

export interface HeadProps {
  locale: Locale;
  title: string;
  description: string;
  /** English path of this page (with trailing slash). */
  path: string;
  /** Canonical + hreflang alternates (false: noindex, e.g. the 404 pages). */
  indexable?: boolean;
  /** OG image key ("home", "cv", "privacy", "work-<slug>"). */
  ogKey?: string;
  /** og:image:alt / twitter:image:alt: a description of this page's sharing card (default: the home card's). */
  ogImageAlt?: string;
  ogType?: "website" | "article" | "profile";
  /** For ogType "article": publication and last-change dates (YYYY-MM-DD) for the article:* tags. */
  article?: { published: string; modified: string };
  jsonLd?: readonly object[];
  /** Browser-chrome colours (default: the page background in each theme; dark is the default theme). */
  themeColor?: { light: string; dark: string };
  /**
   * Fonts to preload beyond the defaults (EN pages: the display face and Inter, the lede's face: on phones the lede is
   * the LCP element and it re-wrapped when Inter swapped in late, CLS ≈ 0.07 at 360 px, audit PERF-02; AR pages: all
   * three Plex Arabic weights, ≈53 KB after scripts/subset-fonts.mjs. Preloading only 700, as first planned, let
   * 400/600 swap in late and shift the page, CLS ≈ 0.03 on phones). `sans` also preloads Inter on Arabic pages: the
   * CV's sheet sets its Latin runs (names, tools) in Inter, and its summary shifted when Inter swapped in late.
   */
  preloadFonts?: { sans?: boolean; arabicWeights?: readonly (400 | 600 | 700)[] };
  /** Extra <link rel="preload"> for this page's LCP image, if any. */
  preload?: readonly { href: string; as: "image"; type?: string; imagesrcset?: string; imagesizes?: string }[];
}

const {
  locale,
  title,
  description,
  path,
  indexable = true,
  ogKey = "home",
  ogImageAlt,
  ogType = "website",
  article,
  jsonLd = [],
  themeColor = { light: "#F7F6F3", dark: "#080E1C" },
  preloadFonts = {},
  preload = [],
} = Astro.props as HeadProps;

const m = messages(locale);
const other = otherLocale(locale);
const canonical = absolute(localePath(path, locale));
const og = absolute(ogPath(ogKey, locale));
const ogAlt = ogImageAlt ?? m.meta.ogImageAlt;
const token = import.meta.env.PROD ? analyticsToken() : undefined;
const arabicPreload = (preloadFonts.arabicWeights ?? [400, 600, 700]).map((weight) => ({ weight }));
/**
 * Arabic case-study pages put Latin names in the H1 and summary ("ArabsStock", "LangGraph") above the meta card;
 * when Space Grotesk / Inter swapped in late the re-wrapped lines pushed the card down (CLS ≈ 0.04 on phones), so
 * those pages preload the two Latin faces as well (measured: CLS 0, Lighthouse mobile 99).
 */
const latinOnArabicCase = locale === "ar" && path.startsWith("/work/");
const alternates = indexable
  ? [
      { hreflang: "en", href: absolute(localePath(path, "en")) },
      { hreflang: "ar", href: absolute(localePath(path, "ar")) },
      { hreflang: "x-default", href: absolute(localePath(path, "en")) },
    ]
  : [];
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
<title>{title}</title>
<meta name="description" content={description} />
{/*
  Dark is the default for every visitor, whatever the OS setting; light only when the visitor picked it (stored in
  localStorage "mh-theme"). The metas say dark, so the browser's first frame and its chrome are dark too; the boot
  script (after them, so it can reach them) switches the page, the canvas and the chrome to light before first paint
  for a visitor who chose light. scripts/site.ts keeps them in step with the toggle.
*/}
<meta name="theme-color" content={themeColor.dark} data-light={themeColor.light} data-dark={themeColor.dark} />
<meta name="color-scheme" content="dark" />
<script is:inline>
  (() => {
    const d = document.documentElement;
    d.classList.add("js");
    let m;
    try { m = localStorage.getItem("mh-theme"); } catch {}
    const light = m === "light";
    d.dataset.theme = light ? "light" : "dark";
    if (light) {
      const c = document.querySelector('meta[name="theme-color"]');
      if (c) c.content = c.dataset.light;
      document.querySelector('meta[name="color-scheme"]').content = "light";
    }
  })();
</script>
{indexable ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
<Font cssVariable="--font-face-display" preload={locale === "en" || latinOnArabicCase} />
<Font cssVariable="--font-face-sans" preload={locale === "en" || latinOnArabicCase || !!preloadFonts.sans} />
<Font cssVariable="--font-face-mono" />
{locale === "ar" && <Font cssVariable="--font-face-arabic" preload={arabicPreload} />}
{preload.map((p) => <link rel="preload" {...p} fetchpriority="high" />)}
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href={locale === "ar" ? "/ar.webmanifest" : "/site.webmanifest"} />
<meta name="apple-mobile-web-app-title" content={m.pwa.shortName} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={m.meta.siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={m.locale.ogLocale} />
<meta property="og:locale:alternate" content={messages(other).locale.ogLocale} />
<meta property="og:image" content={og} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og} />
<meta name="twitter:image:alt" content={ogAlt} />
{
  ogType === "article" && article && (
    <>
      <meta property="article:published_time" content={article.published} />
      <meta property="article:modified_time" content={article.modified} />
      <meta property="article:author" content={absolute("/")} />
    </>
  )
}
<meta name="author" content={m.meta.siteName} />
<meta name="format-detection" content="telephone=no" />
{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />)}
{token && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token })} />}
