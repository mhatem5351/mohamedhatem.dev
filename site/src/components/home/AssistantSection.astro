---
/**
 * 05 AI assistant (DESIGN.md 12.14b): what the assistant is, how it works (question → Worker → Gemini → answer),
 * and a faithful static preview of the real widget (welcome state only; never a fabricated answer).
 * The preview is the panel's own anatomy (audit M-05): the drawn avatar the panel's header shows (the launcher's art,
 * cropped on the face, with the online dot on it), title and subtitle, the welcome, the disclaimer line, the suggestion
 * pills, and the composer with its separate send button, on the panel's radius. It is decorative (aria-hidden) and
 * opens the chat on click; keyboard and screen-reader users use the "Start a conversation" button, which does the same.
 */
import "~/styles/home-b.css";
import avatarArt from "../../../../design/assets/avatar/mh-avatar.svg?raw";
import BidiText from "~/components/ui/BidiText.astro";
import Icon from "~/components/ui/Icon.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import suggestions from "@content/chat/suggestions.json";
import { messages, type Locale } from "~/lib/i18n";
import { noBreakHtml } from "~/lib/nobreak";
import { link } from "~/lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages(locale);
const chips = suggestions[locale].slice(0, 4);
const flow = [m.assistant.flow.question, m.assistant.flow.worker, m.assistant.flow.model, m.assistant.flow.answer];
/** The panel header's avatar (chat-avatar.ts HEADER_SVG): the launcher's drawing cropped on the face, its own ids. */
const face = avatarArt
  .replace(/<!--[\s\S]*?-->|\n\s*/g, "")
  .replaceAll("mha-", "mhp-")
  .replace('viewBox="-14 -10 148 140"', 'viewBox="14 6 92 92"');
---
<section class="section" id="assistant" aria-labelledby="assistant-title">
  <div class="container assist">
    <div class="stack stack-lg">
      <SectionHeader variant="rule" index="06" eyebrow={m.assistant.eyebrow} title={m.assistant.title} titleId="assistant-title" />
      <h2 class="sec-head__title title-14ch" id="assistant-title">{m.assistant.title}</h2>
      <p class="lede">{m.assistant.lead}</p>
      <ol class="assist-flow" aria-label={m.assistant.flowLabel}>
        {
          flow.map((step) => (
            <li>
              <b>{step.title}</b>
              <span set:html={noBreakHtml(step.detail, "nowrap")} />
            </li>
          ))
        }
      </ol>
      <p class="t-sm muted assist__how">{m.assistant.howItWorks}</p>
      <div class="cluster gap-loose">
        <button class="btn btn--accent" type="button" data-open-chat aria-haspopup="dialog" data-chat-avoid data-js-only>
          <Icon name="ask" />
          {m.assistant.open}
        </button>
        <a class="btn btn--ghost" href={link("site-source").href}>
          <Icon name="github" />
          {m.assistant.howBuilt}
        </a>
      </div>
    </div>
    <div class="chat-preview-wrap">
      <div class="chat-preview" data-open-chat aria-hidden="true">
        <span class="chat-preview__head">
          <span class="chat-preview__av"><Fragment set:html={face} /><i class="dot"></i></span>
          <span class="chat-preview__who">
            <b>{m.chat.title}</b>
            <small>{m.chat.subtitle}</small>
          </span>
          <i class="chat-preview__x"><Icon name="close" size="sm" /></i>
        </span>
        <span class="chat-preview__body">
          <span class="chat-preview__msg">{m.chat.greeting}</span>
          <span class="chat-preview__note">{m.chat.disclaimer}</span>
          <span class="chat-preview__chips">
            {/* In the page's direction, only the other script's runs isolated (lib/bidi.ts; audit A-01). */}
            {chips.map((c) => (
              <span>
                <BidiText text={c.label} locale={locale} />
              </span>
            ))}
          </span>
        </span>
        <span class="chat-preview__composer">
          <span class="chat-preview__field">{m.chat.placeholder}</span>
          <i class="chat-preview__go"><Icon name="arrow-up" size="sm" /></i>
        </span>
      </div>
    </div>
  </div>
</section>
