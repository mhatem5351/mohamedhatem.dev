---
/**
 * 07 Skills (DESIGN.md 12.15): "skills with receipts", a real table where every filled dot is a role, freelance
 * project or public repository that used the skill (data and evidence in src/lib/skills-matrix.ts), then the full
 * toolbox from profile.skills with LinkedIn endorsement counts and the passed assessment.
 * Phones (below 40rem): the same data as a list, each skill followed by chips of the places it was used (a seven-
 * column table would show one column at a time there), and the toolbox behind a "Show all N tools" disclosure.
 */
import "~/styles/home-b.css";
import Icon from "~/components/ui/Icon.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import { format, messages, pluralize, type Locale } from "~/lib/i18n";
import { profile } from "~/lib/site";
import { GROUP_ACCENT, MATRIX_COLUMNS, matrixGroups } from "~/lib/skills-matrix";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages(locale);
const mx = m.skills.matrix;
const groups = matrixGroups();
const colCount = MATRIX_COLUMNS.length + 1;
const toolCount = profile.skills.reduce((n, g) => n + g.skills.length, 0);

/** Toolbox group colours, in the same category language as the matrix. */
const GROUP_COLOR: Record<string, string> = {
  "llm-agents": "teal",
  retrieval: "saffron",
  "serving-mlops": "slate",
  quality: "sky",
  backend: "slate",
  ml: "coral",
  cloud: "sky",
  frontend: "coral",
  "ways-of-working": "sage",
};
---
<section class="section" id="skills" aria-labelledby="skills-title">
  <div class="container">
    <SectionHeader index="07" eyebrow={m.skills.eyebrow} title={m.skills.title} titleId="skills-title" lede={m.skills.lead} />

    <div class="card card--pad matrix-card" data-motion-once>
      <div class="matrix-card__head">
        <h3 class="matrix-card__title" id="matrix-title">{mx.title}</h3>
        <p class="matrix-card__lead">{mx.lead}</p>
      </div>
      <div class="matrix-wrap" tabindex="0" role="region" aria-label={m.a11y.skillsTable} data-scroll-region>
        <table class="matrix" aria-describedby="matrix-title">
          <caption class="sr-only">{mx.caption}</caption>
          <thead>
            <tr>
              <th scope="col">{mx.skill}</th>
              {
                MATRIX_COLUMNS.map((c) => (
                  <th scope="col">
                    <span dir="auto">{mx.columns[c]}</span>
                  </th>
                ))
              }
            </tr>
          </thead>
          {
            groups.map(({ group, rows }) => (
              <tbody>
                <tr class:list={["grp", `accent-${GROUP_ACCENT[group]}`]}>
                  <th colspan={colCount} scope="rowgroup">
                    <span class="matrix__grp">{mx.groups[group]}</span>
                  </th>
                </tr>
                {rows.map((row) => (
                  <tr class={`accent-${GROUP_ACCENT[group]}`}>
                    <th scope="row">
                      <span dir="auto">{mx.rows[row.key]}</span>
                    </th>
                    {MATRIX_COLUMNS.map((c) =>
                      row.cells[c] ? (
                        <td>
                          <i class="y" />
                          <span class="sr-only">{mx.yes}</span>
                        </td>
                      ) : (
                        <td>
                          <i class="n" />
                          <span class="sr-only">{mx.no}</span>
                        </td>
                      ),
                    )}
                  </tr>
                ))}
              </tbody>
            ))
          }
        </table>
      </div>
      {/* Phones: one entry per skill with the places it was used, from the same rows (no sideways scrolling). */}
      <div class="matrix-list" data-matrix-list>
        {
          groups.map(({ group, rows }) => (
            <div class:list={["matrix-list__group", `accent-${GROUP_ACCENT[group]}`]}>
              <h4 class="matrix-list__title">{mx.groups[group]}</h4>
              <ul class="matrix-list__rows" role="list">
                {rows.map((row) => (
                  <li class="matrix-list__row">
                    <span class="matrix-list__skill" dir="auto">{mx.rows[row.key]}</span>
                    <span class="sr-only">{locale === "ar" ? "، " : ", "}{m.skills.usedIn}: </span>
                    <span class="matrix-list__where">
                      {MATRIX_COLUMNS.filter((c) => row.cells[c]).map((c, i, all) => (
                        <span class="matrix-list__place">
                          {mx.columns[c]}
                          {i < all.length - 1 && <span class="sr-only">{locale === "ar" ? "، " : ", "}</span>}
                        </span>
                      ))}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="matrix-legend"><span>{mx.earlierNote}</span></p>
    </div>

    <div class="toolbox" data-toolbox>
      <h3 class="toolbox__title" id="toolbox-title">{mx.allTitle}</h3>
      {/* Phones with JavaScript: collapsed behind this button (site.ts); without JavaScript everything shows. */}
      <button class="btn btn--secondary toolbox__toggle" type="button" aria-expanded="false" aria-controls="toolbox-body" data-toolbox-toggle>
        {format(mx.allToggle, { count: String(toolCount) })}
        <Icon name="chevron-down" class="toolbox__chev" />
      </button>
      <div class="toolbox__body" id="toolbox-body">
      <ul class="toolbox__grid" role="list" aria-labelledby="toolbox-title">
        {
          profile.skills.map((g) => (
            <li class={`toolbox__group accent-${GROUP_COLOR[g.id] ?? "teal"}`}>
              <h4>{g.title[locale]}</h4>
              <p class="toolbox__summary">{g.summary[locale]}</p>
              <ul class="toolbox__list" role="list">
                {g.skills.filter((s) => s.evidence.length > 0).map((s) => (
                  <li class="tool">
                    <span dir="auto">{s.name[locale]}</span>
                    {s.endorsements !== undefined && (
                      <>
                        <span class="tool__count" aria-hidden="true">
                          {s.endorsements}
                        </span>
                        <span class="sr-only">({pluralize(m.skills.endorsements, s.endorsements, locale)})</span>
                      </>
                    )}
                    {s.assessmentPassed && <Icon name="check" class="tool__check" label={m.skills.assessmentPassed} />}
                  </li>
                ))}
              </ul>
              {/* Listed on my CV or profiles, but with no project on this site to show for them: kept apart from the
                  production claims above (content/README.md, audit FC-8). */}
              {g.skills.some((s) => s.evidence.length === 0) && (
                <p class="toolbox__also">
                  <span class="toolbox__also-label">{m.skills.alsoWorkedWith}:</span>{" "}
                  {/* One flat array: no JSX whitespace may land before a comma. */}
                  {g.skills
                    .filter((s) => s.evidence.length === 0)
                    .flatMap((s, i) => [
                      ...(i > 0 ? [locale === "ar" ? "، " : ", "] : []),
                      <bdi>{s.name[locale]}</bdi>,
                      ...(s.endorsements !== undefined
                        ? [<span class="tool__count" aria-hidden="true">{s.endorsements}</span>, <span class="sr-only">({pluralize(m.skills.endorsements, s.endorsements, locale)})</span>]
                        : []),
                    ])}
                </p>
              )}
            </li>
          ))
        }
      </ul>
      <p class="toolbox__note" aria-hidden="true">
        <span><Icon name="check" class="tool__check" />{m.skills.assessmentPassed}</span>
      </p>
      </div>
    </div>
  </div>
</section>

<script>
  // The receipts pop in column by column the first time the matrix is on screen (components.css 20a).
  import "~/scripts/motion.ts";
</script>
