---
/**
 * 09 Contact (DESIGN.md 12.17): direct channels first (WhatsApp and email are the quickest; the Gmail address sits
 * in the Email card as "or …", then LinkedIn and GitHub), the form second. The email row has a copy button
 * (src/scripts/site.ts copies and announces through the page's live region). Every card is one link (the Email card's
 * main area is its link, with the copy button beside it and the Gmail line under it), and the last one adds the contact card
 * (/mohamed-hatem.vcf: the phone's "new contact" sheet).
 */
import "~/styles/home-b.css";
import Icon from "~/components/ui/Icon.astro";
import Ltr from "~/components/ui/Ltr.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import ContactForm from "~/components/home/contact/ContactForm.astro";
import { cairoTime, messages, type Locale } from "~/lib/i18n";
import { CV_PDF, contact, link, mailtoHref, profile, whatsappHref } from "~/lib/site";
import { VCARD_PATH } from "~/lib/vcard";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages(locale);
const email = contact("email");
const gmail = contact("gmail");
const whatsapp = contact("whatsapp");
const linkedin = link("linkedin");
const github = link("github");
const [timeBefore, timeAfter] = m.contact.localTime.split("{time}") as [string, string];
/** On a narrow phone an address wraps after its "@", never inside a word. */
const [emailUser, emailDomain] = email.display.split("@") as [string, string];
/** The CV as a channel (round 7, R7-25), once the copy has its row. */
const cvChannel = (m.contact.channels as { cv?: { title: string; action: string } }).cv;
---
<section class="section section--band" id="contact" aria-labelledby="contact-title">
  <div class="container contact">
    <div class="contact__copy">
      <SectionHeader variant="rule" index="09" eyebrow={m.contact.eyebrow} title={m.contact.title} titleId="contact-title" />
      <h2 class="contact__title" id="contact-title">{m.contact.title}</h2>
      <p class="lede contact__lede">
        {m.contact.lead}
        {" "}
        <span data-js-only>{m.contact.askFirst.before}{" "}<button class="link" type="button" data-open-chat aria-haspopup="dialog">{m.contact.askFirst.action}</button>{" "}{m.contact.askFirst.after}</span>
      </p>
      <p class="contact__time" data-js-only>
        <i class="dot" aria-hidden="true"></i>
        <span>{timeBefore}<Ltr><time data-cairo-time>{cairoTime(locale)}</time></Ltr>{timeAfter}</span>
      </p>
      <ul class="channels" role="list">
        <li>
          <a class="channel" href={whatsappHref(locale)}>
            <span class="icon-tile"><Icon name="whatsapp" /></span>
            <span>
              <span class="channel__label">{m.contact.channels.whatsapp.title}</span><br />
              <span class="channel__value"><Ltr>{whatsapp.display}</Ltr></span>
            </span>
            <Icon name="arrow-up-right" size="sm" class="channel__arrow" />
          </a>
        </li>
        <li>
          <div class="channel channel--split">
            {/* The card's main area is one link (like the other cards); the copy button and the Gmail line sit beside it. */}
            <a class="channel__main" href={mailtoHref(locale)}>
              <span class="icon-tile icon-tile--saffron"><Icon name="mail" /></span>
              <span>
                <span class="channel__label">{m.contact.channels.email.title}</span><br />
                <span class="channel__value"><Ltr>{emailUser}@<wbr />{emailDomain}</Ltr></span>
              </span>
            </a>
            <button
              class="btn btn--ghost btn--sm btn--icon channel__copy"
              data-chat-avoid
              data-js-only
              type="button"
              data-copy={email.display}
              data-copied={m.contact.emailCopied}
              data-copy-failed={m.common.copyFailed}
              aria-label={m.contact.copyEmail}
              title={m.contact.copyEmail}
            >
              <Icon name="copy" class="i-copy" />
              <Icon name="check" class="i-check" />
            </button>
            {/* The Gmail address as a second way to write, inside the Email card (not a half-styled row of its own). */}
            <span class="channel__alt">{m.contact.channels.email.or} <a href={mailtoHref(locale, "gmail")}><Ltr>{gmail.display}</Ltr></a></span>
          </div>
        </li>
        {
          cvChannel && (
            <li>
              <a class="channel" href={CV_PDF[locale]} download={profile.cv.fileName[locale]} type="application/pdf" data-open-on-touch>
                <span class="icon-tile icon-tile--saffron"><Icon name="file-text" /></span>
                <span>
                  <span class="channel__label">{cvChannel.title}</span><br />
                  <span class="channel__value">{cvChannel.action}</span>
                </span>
                <Icon name="download" size="sm" class="channel__arrow" />
              </a>
            </li>
          )
        }
        <li>
          <a class="channel" href={linkedin.href} rel="me">
            <span class="icon-tile icon-tile--sky"><Icon name="linkedin" /></span>
            <span>
              <span class="channel__label">{m.contact.channels.linkedin.title}</span><br />
              <span class="channel__value"><Ltr>{linkedin.display.replace(/^linkedin\.com\//, "")}</Ltr></span>
            </span>
            <Icon name="arrow-up-right" size="sm" class="channel__arrow" />
          </a>
        </li>
        <li>
          <a class="channel" href={github.href} rel="me">
            <span class="icon-tile icon-tile--slate"><Icon name="github" /></span>
            <span>
              <span class="channel__label">{m.contact.channels.github.title}</span><br />
              <span class="channel__value"><Ltr>{github.display.replace(/^github\.com\//, "")}</Ltr></span>
            </span>
            <Icon name="arrow-up-right" size="sm" class="channel__arrow" />
          </a>
        </li>
        <li>
          <a class="channel" href={VCARD_PATH}>
            <span class="icon-tile icon-tile--coral"><Icon name="user-plus" /></span>
            <span>
              <span class="channel__label">{m.contact.channels.vcard.value}</span><br />
              <span class="channel__value">{m.contact.channels.vcard.title}</span>
            </span>
            <Icon name="download" size="sm" class="channel__arrow" />
          </a>
        </li>
      </ul>
    </div>
    <ContactForm locale={locale} />
  </div>
</section>
