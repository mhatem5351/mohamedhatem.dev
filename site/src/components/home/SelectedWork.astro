---
/**
 * 01 Selected work (DESIGN.md 12.10): featured case studies (feature card first, then the grid; an orphan last card
 * becomes a wide card), then the compact "More work" list: the case studies that aren't featured (content/profile.ts
 * `featured: false`: the briefs, whose implementation details aren't public, and the freelance logic-controls.com
 * site). Every card links to its case-study page; the logic-controls.com card keeps the old /#craft anchor wherever it
 * sits. "More work" never leaves one card alone on a row: three in a row, or two by two for an even count.
 * Phones: "More work" sits behind a "Show more work (n)" disclosure (with JS; open without it), like the toolbox.
 */
import CaseCard from "~/components/work/CaseCard.astro";
import Icon from "~/components/ui/Icon.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import { workLayout } from "~/lib/home-work";
import { format, messages, type Locale } from "~/lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages(locale);
const { feature, grid, wide, more } = workLayout();
/** The home page's former front-end showcase anchor (/#craft) now lands on the logic-controls.com card. */
/** Each card is an anchor (the metric strip links to its proof; audit H-33); logic-controls.com keeps the old "#craft". */
const anchorOf = (cs: { slug: string }) => (cs.slug === "logic-controls-website" ? "craft" : `work-${cs.slug}`);
/** "More work" in rows of three, unless that would leave one card alone: an even count goes two by two (4 = 2 × 2). */
const pairs = more.length % 3 === 1 && more.length % 2 === 0;
---
<section class="section section--band" id="work" aria-labelledby="work-title">
  <div class="container">
    <SectionHeader index="01" eyebrow={m.work.eyebrow} title={m.work.title} titleId="work-title" lede={m.work.lead} />
    <div class="work-list">
      {feature && <CaseCard cs={feature} locale={locale} variant="feature" id={anchorOf(feature)} />}
      {
        grid.map((cs, i) => (
          <CaseCard cs={cs} locale={locale} i={(i % 3) + 1} id={anchorOf(cs)} class={grid.length % 2 === 1 && i === grid.length - 1 ? "work--span-md" : undefined} />
        ))
      }
      {wide && <CaseCard cs={wide} locale={locale} variant="wide" id={anchorOf(wide)} />}
    </div>
    {
      more.length > 0 && (
        <div class="more-work disclose" data-disclose>
          <h3 class="eyebrow more-work__title">{m.work.moreTitle}</h3>
          <button class="btn btn--secondary disclose__toggle" type="button" aria-expanded="false" aria-controls="more-work-list" data-disclose-toggle>
            {format(m.work.moreToggle, { count: more.length })}
            <Icon name="chevron-down" class="disclose__chev" />
          </button>
          <div class:list={["more-work__list disclose__body", pairs && "more-work__list--pairs"]} id="more-work-list">
            {more.map((cs, i) => (
              <CaseCard cs={cs} locale={locale} variant="compact" i={(i % 3) + 1} headingLevel={4} id={anchorOf(cs)} />
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  /* Two-column tablets: an odd last grid card takes the full row instead of leaving a hole, its drawing in a wide band
     above the text (side by side, the drawing filled 41 % of a tall media column; audit R7-HOME-06). */
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .work-list :global(.work--span-md) {
      grid-column: 1 / -1;
    }
    .work-list :global(.work--span-md .work__media) {
      aspect-ratio: 16 / 7;
    }
  }
  .more-work {
    margin-block-start: var(--space-stack);
    display: grid;
    gap: 1rem;
  }
  .more-work__title {
    margin: 0;
  }
  .more-work__list {
    display: grid;
    gap: var(--grid-gap);
  }
  /* More work: three compact cards in a row (two by two for an even count that three would orphan); on tablets two,
     the odd last one across the row. */
  @media (min-width: 48rem) {
    .more-work__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .more-work__list > :global(.work:last-child:nth-child(odd)) {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 64rem) {
    .more-work__list:not(.more-work__list--pairs) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .more-work__list > :global(.work:last-child:nth-child(odd)) {
      grid-column: auto;
    }
  }
</style>
