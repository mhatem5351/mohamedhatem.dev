---
/**
 * 02 What I build (DESIGN.md 12.9): a bento of five capability cards. The feature card carries the agent-orchestration
 * pattern (decorative thumbnail on a dot-grid inset, moving while on screen, with its pause button); the four
 * others sit two beside it and two under it (components.css 11). The front end is part of "Arabic and English" (the
 * right-to-left interface) and of the logic-controls.com case study in Selected work.
 */
import Icon from "~/components/ui/Icon.astro";
import MotionToggle from "~/components/ui/MotionToggle.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import { diagramSvg } from "~/lib/diagrams";
import { messages, type Locale } from "~/lib/i18n";
import { noBreakHtml } from "~/lib/nobreak";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages(locale);
const c = m.capabilities;

type Key = "retrieval" | "serving" | "evaluation" | "bilingual";
const cards: { key: Key; icon: string; tile: string }[] = [
  { key: "retrieval", icon: "retrieve", tile: "icon-tile--saffron" },
  { key: "serving", icon: "serving", tile: "icon-tile--slate" },
  { key: "evaluation", icon: "evaluate", tile: "icon-tile--sky" },
  { key: "bilingual", icon: "bilingual", tile: "icon-tile--sage" },
];
/** "A · B · C" → items (the first emphasised), set as a separator list (components.css .sep-list: a "·" never
 *  dangles at a line's edge; audit H-07); Latin-only stack lines stay LTR on Arabic pages. */
const stack = (line: string) => ({ items: line.split(" · "), ltr: !/[؀-ۿ]/.test(line) });
/** The pattern itself (router, subgraph agents, a model, evaluation; no client), not the Wakeb drawing the Wakeb work
 *  card shows one screen earlier (audit R7-HOME-05). */
const featureArt = diagramSvg("agent-orchestration", "thumb", { decorative: true, idSuffix: "cap" });
---
<section class="section" id="what" aria-labelledby="what-title">
  <div class="container">
    <SectionHeader index="02" eyebrow={c.eyebrow} title={c.title} titleId="what-title" lede={c.lead} />
    {/* Phones: one swipeable row (components.css 21i), a keyboard-focusable, labelled region only while it scrolls (site.ts). */}
    <div class="bento" tabindex="0" role="region" aria-label={c.eyebrow} data-scroll-region>
      <article class="card card--pad bento__feature" data-reveal>
        <div class="cap">
          <span class="icon-tile"><Icon name="agents" /></span>
          {/* Compounds ("Multi-agent"), domains and ranges never split (R7-HOME-03). */}
          <h3 class="cap__title" set:html={noBreakHtml(c.agents.title, "nowrap")} />
          <p class="cap__body" set:html={noBreakHtml(c.agents.body, "nowrap")} />
          {
            (() => {
              const s = stack(c.agents.stack);
              return (
                <p class="cap__stack sep-list" dir={locale === "ar" && s.ltr ? "ltr" : undefined}>
                  <span class="sep-list__in">{s.items.map((it, j) => (j === 0 ? <b>{it}</b> : <span>{it}</span>))}</span>
                </p>
              );
            })()
          }
        </div>
        <div class="feature-art" dir="ltr" data-motion="dg-play">
          <Fragment set:html={featureArt} />
          <MotionToggle locale={locale} variant="corner" />
        </div>
      </article>
      {
        cards.map(({ key, icon, tile }, i) => {
          const s = stack(c[key].stack);
          return (
            <article class="card card--pad cap" data-reveal data-reveal-i={String(i + 1)}>
              <span class={`icon-tile ${tile}`}>
                <Icon name={icon} />
              </span>
              <h3 class="cap__title" set:html={noBreakHtml(c[key].title, "nowrap")} />
              <p class="cap__body" set:html={noBreakHtml(c[key].body, "nowrap")} />
              <p class="cap__stack sep-list" dir={locale === "ar" && s.ltr ? "ltr" : undefined}>
                <span class="sep-list__in">{s.items.map((it, j) => (j === 0 ? <b>{it}</b> : <span>{it}</span>))}</span>
              </p>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  /* Arabic stack lines set LTR still align to the card's start (the right edge). */
  :global([dir="rtl"]) .cap__stack[dir="ltr"] {
    text-align: end;
  }
  :global([dir="rtl"]) .cap__stack[dir="ltr"] > :global(.sep-list__in) {
    justify-content: flex-end;
  }
</style>
