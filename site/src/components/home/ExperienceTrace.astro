---
/**
 * 03 Experience as a trace view (DESIGN.md 12.12, HANDOFF.md 6.2): every role (newest first) and the two study
 * lanes as spans on one timeline from 2020 to the build year, with a dashed "now" line. Rows are <details>, so they
 * work without JS (the current role open); the script opens the two roles before it too on desktop (Wakeb Data,
 * ArabsStock: the agent work a reader looks for, audit HM-30), makes the rows a single-open accordion for the
 * visitor's own clicks, and adds ArrowUp/ArrowDown/Home/End between rows.
 * Bar positions come from src/lib/trace.ts as month "digit classes" that src/styles/home-a.css turns into
 * percentages (no style="": the CSP is hash-only).
 * Motion (src/scripts/motion.ts, components.css 20a): the bars grow in row by row the first time the trace is on
 * screen, and while it is on screen the current role's bar ends in a "now" dot that pings (pause button in the foot).
 */
import type { Role } from "@content/profile.ts";
import Icon from "~/components/ui/Icon.astro";
import LogoTile from "~/components/ui/LogoTile.astro";
import MotionToggle from "~/components/ui/MotionToggle.astro";
import DateRun from "~/components/work/DateRun.astro";
import Emph from "~/components/ui/Emph.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import { glueArabic } from "~/lib/nobreak";
import { formatDuration, formatPeriod, localePath, messages, monthsInclusive, type Locale } from "~/lib/i18n";
import { PATHS, caseStudyBySlug, profile } from "~/lib/site";
import { axis, axisClasses, digitClasses, nowIndex, traceRows, yearIndex, type TraceRow } from "~/lib/trace";
import "~/styles/home-a.css";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages(locale);
const t = m.experience.trace;
const now = new Date();
const ax = axis(now);
const rows = traceRows(now);

const typeLine = (r: Role) => [m.experience.employmentType[r.employmentType], r.workMode ? m.experience.workMode[r.workMode] : null].filter(Boolean).join(locale === "ar" ? "، " : ", ");
const firstPart = (s: string) => s.split(locale === "ar" ? "،" : ",")[0]!.trim();
const isLatin = (s: string) => !/[؀-ۿ]/.test(s);

type Attr = { k: string; v: string; ltr?: boolean; items?: { text: string; latin: boolean }[] };
/** Tech tags: tool names stay Latin (isolated on Arabic pages); descriptive phrases are translated (profile.ts). */
const techItems = (r: Role) =>
  r.tech.map((x) => {
    const text = typeof x === "string" ? x : x[locale];
    return { text, latin: isLatin(text) };
  });
/** "1 yr 8 mos": shown on phones beside the dates, where the timeline lane has no axis (audit READ-04). */
const durationOf = (period: Role["period"]): string | undefined => (/-/.test(period.start) ? formatDuration(monthsInclusive(period, now), locale) : undefined);
function view(row: TraceRow): { title: string; org: string; dates: string; duration?: string | undefined; logo: { file: string | null; monogram: string }; srType: string | null; honors: typeof profile.honors[number][]; attrs: Attr[]; cases: NonNullable<ReturnType<typeof caseStudyBySlug>>[]; bullets: { text: string; strong?: string }[] } {
  if (row.role) {
    const r = row.role;
    const honors = profile.honors.filter((h) => r.honors.includes(h.id));
    return {
      title: glueArabic(r.title[locale]),
      org: r.company[locale],
      dates: formatPeriod(r.period, locale),
      duration: durationOf(r.period),
      logo: { file: r.logo.file ?? r.id, monogram: r.logo.monogram },
      srType: r.employmentType === "full-time" ? null : m.experience.employmentType[r.employmentType],
      honors,
      attrs: [
        { k: t.type, v: typeLine(r) },
        { k: t.location, v: r.location[locale] },
        { k: m.experience.tech, v: "", items: techItems(r) },
        ...honors.map((h) => ({ k: m.experience.award, v: h.title[locale] })),
      ],
      cases: r.caseStudies.map((s) => caseStudyBySlug(s)).filter((c): c is NonNullable<typeof c> => c !== undefined),
      bullets: r.bullets.map((b) => ({ text: b.text[locale], strong: b.strong?.[locale] })),
    };
  }
  const e = row.education!;
  return {
    title: e.degree[locale],
    org: firstPart(e.institution[locale]),
    dates: formatPeriod(e.period, locale, { expected: e.status === "in-progress" }),
    logo: { file: e.logo.file, monogram: e.logo.monogram },
    srType: t.study,
    honors: [],
    attrs: [
      { k: t.location, v: e.institution[locale] },
      ...(e.notes ? [{ k: t.notes, v: e.notes[locale] }] : []),
      ...(e.courses.length ? [{ k: t.courses, v: e.courses.map((c) => c[locale]).join(locale === "ar" ? "، " : ", ") }] : []),
    ],
    cases: [],
    bullets: [],
  };
}
---
<section class="section section--band" id="experience" aria-labelledby="exp-title">
  <div class="container">
    <SectionHeader index="03" eyebrow={m.experience.eyebrow} title={m.experience.title} titleId="exp-title" lede={m.experience.lead} />
    <div class={`card trace ${axisClasses(now)}`} data-trace data-motion="is-live" data-motion-once>
      <div class="trace__head">
        <span class="eyebrow">{t.roleColumn}</span>
        <div class="axis" aria-hidden="true">
          {ax.years.map((y) => <span class={digitClasses("p", yearIndex(y, ax))}>{y}</span>)}
        </div>
      </div>
      <div class="trace__rows">
        <div class="trace__grid" aria-hidden="true">
          <div></div>
          <div>
            {ax.years.map((y) => <i class={`yr ${digitClasses("p", yearIndex(y, ax))}`}></i>)}
            <i class={`now ${digitClasses("p", nowIndex(now))}`} data-label={t.now}></i>
          </div>
        </div>
        {
          rows.map((row) => {
            const v = view(row);
            const g = row.geometry;
            return (
              <details
                class={`span span--${row.id} accent-${row.accent} ${row.classes}`}
                open={row.role?.period.end === null ? true : undefined}
                data-open-wide={row.id === "wakeb" || row.id === "arabsstock" ? "" : undefined}
              >
                <summary>
                  {/* One heading per role (h3 under the section's h2), so heading navigation lists the career. */}
                  <h3 class="span__who">
                    <LogoTile file={v.logo.file} monogram={v.logo.monogram} size={36} class="span__logo" />
                    <span class="span__text">
                      <span class="span__role">
                        {v.title}
                        {v.honors.map((h) => (
                          <Icon name="award" class="span__award" label={`${m.experience.award}: ${h.title[locale]}`} />
                        ))}
                      </span>
                      <span class="span__org sep-list">
                        {/* Each organisation name, the date range and the duration are unbreakable units ("Umm
                            Al-Qura University", "Jan 2020 – Jan 2021"): lines break only between them (audit VUX-08),
                            and the "·" between them never ends or starts a line (separator list; audit H-07). */}
                        <span class="sep-list__in">
                          {v.org.split(" · ").map((part) => (
                            <span class="span__unit" lang={isLatin(part) ? "en" : undefined}>{part}</span>
                          ))}
                          <span class="span__when"><DateRun text={v.dates} class="span__unit" /></span>
                          {v.duration && (
                            <span class="span__dur">
                              <span class="span__unit">{v.duration}</span>
                            </span>
                          )}
                          {v.srType && <span class="sr-only">, {v.srType}</span>}
                        </span>
                      </span>
                    </span>
                    <Icon name="chevron-down" size="sm" class="span__chev" />
                  </h3>
                  <span class="span__lane" aria-hidden="true">
                    <i
                      class:list={[
                        "span__bar",
                        row.bar === "pt" && "span__bar--pt",
                        row.bar === "study" && "span__bar--study",
                        g.live && "span__bar--live",
                      ]}
                    />
                    <span class:list={["span__dates", g.before && "span__dates--before"]}>
                      <DateRun text={v.dates} />
                    </span>
                  </span>
                </summary>
                <div class="span__detail">
                  <dl class="span__attrs">
                    {v.attrs.map((a) => (
                      <div>
                        <dt>{a.k}</dt>
                        <dd>
                          {a.items
                            ? a.items.flatMap((it, i) => [
                                ...(i > 0 ? [locale === "ar" ? "، " : ", "] : []),
                                it.latin ? <bdi dir="ltr" lang="en">{it.text}</bdi> : it.text,
                              ])
                            : a.ltr
                              ? <bdi dir="ltr" lang="en">{a.v}</bdi>
                              : a.v}
                        </dd>
                      </div>
                    ))}
                    {v.cases.length > 0 && (
                      <div>
                        <dt>{m.experience.caseStudy}</dt>
                        <dd class="span__cases">
                          {v.cases.map((c) => (
                            <a class="link" href={localePath(PATHS.work(c.slug), locale)}>
                              {c.shortTitle[locale]}
                            </a>
                          ))}
                        </dd>
                      </div>
                    )}
                  </dl>
                  {v.bullets.length > 0 && (
                    <ul class="span__bullets">
                      {v.bullets.map((b) => (
                        <li>
                          <Emph text={b.text} strong={[b.strong]} />
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </details>
            );
          })
        }
      </div>
      <div class="trace__foot">
        <div class="trace__legend" aria-hidden="true">
          <span><i class="ft"></i>{t.fullTime}</span>
          <span><i class="pt"></i>{t.partTime}</span>
          <span><i class="st"></i>{t.study}</span>
        </div>
        <span class="trace__foot-end">
          <span class="t-xs muted trace__hint">{t.keyboardHint}</span>
          <MotionToggle locale={locale} variant="up" />
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .trace__legend i.ft {
    background: var(--color-teal-fill);
  }
  .trace :global(.span__award) {
    display: inline;
    vertical-align: -0.2em;
    margin-inline-start: 0.25rem;
    width: 1rem;
    height: 1rem;
    color: var(--color-saffron);
  }
  .trace__foot-end {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-inline-start: auto;
  }
  .span__cases {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }
  /* An in-progress degree: outlined (study) and fading into "now". */
  .span__bar--study.span__bar--live {
    background: transparent;
    -webkit-mask-image: linear-gradient(90deg, #000 72%, transparent);
    mask-image: linear-gradient(90deg, #000 72%, transparent);
  }
  :global([dir="rtl"]) .span__bar--study.span__bar--live {
    -webkit-mask-image: linear-gradient(-90deg, #000 72%, transparent);
    mask-image: linear-gradient(-90deg, #000 72%, transparent);
  }
  /* The keyboard hint only helps where there is a keyboard. */
  @media (hover: none) and (pointer: coarse) {
    .trace__hint {
      display: none;
    }
  }
  @media (max-width: 47.99rem) {
    .span__lane {
      background: repeating-linear-gradient(
        90deg,
        transparent 0 calc(100% / var(--trace-years, 7) - 1px),
        var(--color-line) calc(100% / var(--trace-years, 7) - 1px) calc(100% / var(--trace-years, 7))
      );
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .trace :global(.span__chev) {
      transition: none;
    }
  }
</style>

<script>
  for (const trace of document.querySelectorAll<HTMLElement>("[data-trace]")) {
    const rows = [...trace.querySelectorAll<HTMLDetailsElement>("details.span")];
    const sums = rows.map((r) => r.querySelector("summary")!);
    // Desktop: the roles marked data-open-wide open with the current one.
    if (matchMedia("(min-width: 64rem)").matches) for (const r of rows) if (r.hasAttribute("data-open-wide")) r.open = true;
    // Single-open accordion for the visitor's own opening (a click, or Enter / Space on a row): the others close. Rows
    // opened by default stay open until then.
    for (const [i, r] of rows.entries())
      sums[i]!.addEventListener("click", () => {
        if (!r.open) for (const o of rows) if (o !== r) o.open = false;
      });
    // Arrow keys move between rows (one row = one stop in the list), Home/End jump to the ends.
    trace.addEventListener("keydown", (e) => {
      const i = sums.indexOf(document.activeElement as HTMLElement);
      if (i < 0) return;
      const to = ({ ArrowDown: i + 1, ArrowUp: i - 1, Home: 0, End: sums.length - 1 } as Record<string, number>)[e.key];
      if (to === undefined) return;
      e.preventDefault();
      sums[Math.max(0, Math.min(sums.length - 1, to))]!.focus();
    });
  }
</script>
