---
/**
 * "Worked at" row (DESIGN.md 12.7): each company's official logo in its real colours (design/assets/logos/brand,
 * built by design/scripts/brand/brand-logos.mjs; sources in design/assets/logos/SOURCES.md), optically balanced
 * (equal visual area, so a long wordmark sits lower than a stacked lockup). One file per theme: the dark page uses the
 * company's official reversed artwork, or a light rendition of only the parts that would vanish, so every logo holds
 * 3:1 against the page. Both files load with the page (eager: six small files), so switching the theme swaps them in
 * the same frame instead of blanking the row for a round trip (audit M-03); the light set, hidden by default, at low
 * priority.
 * The logos carry the company name as alt text; MDP is known by its symbol and initials, so its name is real text
 * and the symbol is decorative. Static, not links.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import brand from "~/assets/logos/brand/brand.json";
import { messages, type Locale } from "~/lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages(locale);

type File = { file: string; height: number; width: number };
type Entry = { name: string; symbolOnly: boolean; files: { light: File; dark: File } };
const files = import.meta.glob<{ default: ImageMetadata }>("../../assets/logos/brand/*.{svg,png}", { eager: true });
const src = (f: string) => files[`../../assets/logos/brand/${f}`]!.default;
const ROW = Object.entries(brand.logos as Record<string, Entry>);
/*
 * Raster logos (Empoweromics, Tabaqat) at WebP quality 70: on phones the row is on the first screen, so its bytes count,
 * and at 2x/3x their flat shapes and type stay clean (q92 was ~2.3x the bytes for no visible gain). Vectors are SVG.
 */
---
<div class="logos">
  <p class="eyebrow logos__label">{m.metrics.logosLabel}</p>
  <ul class="logos__list" role="list">
    {
      ROW.map(([key, e]) => {
        const alt = e.symbolOnly ? "" : e.name;
        const same = e.files.light.file === e.files.dark.file;
        const img = (f: File, cls: string, low = false) => (
          <Image
            src={src(f.file)}
            alt={alt}
            width={f.width}
            height={f.height}
            densities={f.file.endsWith(".png") ? [1, 2, 3] : undefined}
            quality={f.file.endsWith(".png") ? 70 : 92}
            class={cls}
            loading="eager"
            fetchpriority={low ? "low" : undefined}
            decoding="async"
          />
        );
        return (
          <li class={`brand-logo brand-logo--${key}`} lang="en">
            {same ? img(e.files.light, "brand-logo__img") : (
              <>
                {img(e.files.light, "brand-logo__img brand-logo__light", true)}
                {img(e.files.dark, "brand-logo__img brand-logo__dark")}
              </>
            )}
            {e.symbolOnly && <span class="brand-logo__name">{e.name}</span>}
          </li>
        );
      })
    }
  </ul>
</div>
