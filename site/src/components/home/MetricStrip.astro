---
/**
 * Metric strip (DESIGN.md 12.6): five sourced facts from profile.metrics, featured first. Value over label (the
 * label is the <dt>, the value the <dd>, shown first with CSS order). No count-up: numbers are content.
 */
import type { Locale } from "~/lib/i18n";
import { profile } from "~/lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const metrics = [...profile.metrics.filter((x) => x.featured), ...profile.metrics.filter((x) => !x.featured)].slice(0, 5);
const latinOnly = (s: string) => !/[؀-ۿ]/.test(s);
---
<dl class="metrics">
  {
    metrics.map((x) => (
      <div class="metric">
        <dt class="metric__label">{x.label[locale]}</dt>
        <dd class="metric__value" dir={locale === "ar" && latinOnly(x.value[locale]) ? "ltr" : undefined}>
          {x.value[locale]}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  /* Arabic: a Latin value (A100) keeps the column's start edge although it is set LTR. */
  :global([dir="rtl"]) .metric__value[dir="ltr"] {
    justify-content: flex-end;
  }
</style>
