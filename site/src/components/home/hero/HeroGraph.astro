---
/**
 * The live agent graph (DESIGN.md 10.1; design/assets/hero-graph). Server-rendered SVG (visible without JS, zero CLS:
 * fixed 600 × 520 aspect ratio, no inline styles), enhanced by the runtime module, loaded after load on idle: request pulses, pause
 * button (persisted), hover/focus highlight, one tab stop with arrow keys, toggletips. Static frame under
 * prefers-reduced-motion. The graph renders its own accessible description and flow caption; the visible caption
 * below invites interaction.
 */
import "~/components/hero-graph/hero-graph.css";
import { renderHeroGraph } from "~/components/hero-graph/render";
import { dirOf, messages, type Locale } from "~/lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages(locale);
---
<div class="hero__art">
  {/* The Arabic page names the nodes in Arabic (m.hero.graph; audit HM-37); English keeps the mono ids. */}
  <Fragment set:html={renderHeroGraph({ lang: locale, dir: dirOf(locale), labels: locale === "ar" ? m.hero.graph : undefined })} />
  <p class="hero__caption"><span class="dot dot--live" aria-hidden="true"></span>{m.hero.graphCaption}</p>
</div>
<script>
  // The runtime (8 KB gzip) loads once the page has loaded and the browser is idle: the server markup is the still
  // frame until then (the graph starts on idle anyway), so its bytes never compete with the first paint on a slow
  // phone connection, where the graph sits below the proof row anyway.
  const start = () => void import("~/components/hero-graph/hero-graph.ts");
  const idle = () => ("requestIdleCallback" in window ? requestIdleCallback(start, { timeout: 2000 }) : setTimeout(start, 300));
  if (document.readyState === "complete") idle();
  else addEventListener("load", idle, { once: true });
</script>
