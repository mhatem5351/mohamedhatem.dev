---
/**
 * 06 Front-end craft (DESIGN.md 12.14): logic-controls.com, freelance. Copy column with the facts (4 languages,
 * Lighthouse, tests, WCAG) and a browser frame + phone bezel. The device images are decorative: the copy states
 * every fact they show, so the frame is hidden from assistive tech. English page: desktop in English, phone in
 * Arabic; Arabic page: the reverse (both languages are always on show).
 * Never shows or names the Logic Controls founder (SOURCES.md).
 */
import "~/styles/home-b.css";
import { Picture } from "astro:assets";
import desktopEn from "~/assets/showcase/lc-desktop-en-1440.webp";
import desktopAr from "~/assets/showcase/lc-desktop-ar-1440.webp";
import phoneEn from "~/assets/showcase/lc-phone-en-780.webp";
import phoneAr from "~/assets/showcase/lc-phone-ar-780.webp";
import Icon from "~/components/ui/Icon.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import { messages, type Locale } from "~/lib/i18n";
import { profile } from "~/lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages(locale);
const project = profile.projects.find((p) => p.id === "logic-controls-website")!;
const live = project.live ?? "https://logic-controls.com";
const domain = new URL(live).hostname;
const [before, after] = m.showcase.lead.split("{site}") as [string, string];
const stats = [m.showcase.stats.languages, m.showcase.stats.lighthouse, m.showcase.stats.tests, m.showcase.stats.wcag];
const desktop = locale === "ar" ? desktopAr : desktopEn;
const phone = locale === "ar" ? phoneEn : phoneAr;
---
<section class="section section--band" id="craft" aria-labelledby="craft-title">
  <div class="container">
    <header class="sec-head">
      <SectionHeader variant="rule" index="06" eyebrow={m.showcase.eyebrow} title={m.showcase.title} titleId="craft-title" />
    </header>
    <div class="show">
      <div class="stack stack-lg">
        <h2 class="sec-head__title title-16ch" id="craft-title">{m.showcase.title}</h2>
        <p class="lede show__lede">
          {before}<a class="link" href={live}><bdi dir="ltr">{domain}</bdi></a>{after}
        </p>
        <ul class="show__stats" role="list">
          {
            stats.map((s) => (
              <li class="show__stat">
                <b>
                  <bdi dir="ltr">{s.value}</bdi>
                </b>{" "}
                <span>{s.label}</span>
              </li>
            ))
          }
        </ul>
        <p class="cap__stack"><bdi dir="ltr">{m.showcase.stack}</bdi></p>
        <div class="cluster gap-loose">
          <a class="btn btn--primary" href={live}>
            {m.showcase.visit}
            <Icon name="arrow-up-right" />
          </a>
          <a class="btn btn--ghost" href={project.repo}>
            <Icon name="github" />
            {m.showcase.source}
          </a>
        </div>
      </div>
      <div class="devices" aria-hidden="true">
        <div class="browser">
          <div class="browser__bar">
            <span class="browser__dots"><i></i><i></i><i></i></span>
            <span class="browser__url">{domain}</span>
            <span class="browser__spacer"></span>
          </div>
          <Picture
            src={desktop}
            formats={["avif", "webp"]}
            widths={[720, 960, 1440]}
            sizes="(min-width: 64rem) 44rem, (min-width: 40rem) 90vw, 100vw"
            width={960}
            height={600}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="phone">
          <Picture src={phone} formats={["avif", "webp"]} widths={[390, 780]} sizes="12rem" width={390} height={844} alt="" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </div>
</section>
