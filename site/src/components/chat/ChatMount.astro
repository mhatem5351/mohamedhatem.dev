---
/**
 * Thin wrapper around the chat widget (../chat-widget, owned by the assistant track; see its src/index.ts).
 *
 * - The widget's loader (~2.6 KB gzip) mounts the floating launcher in a shadow root; the panel and its CSS load on
 *   the first hover / focus / touch of the launcher, on pointerdown / focus of any [data-open-chat] button or the hero's
 *   ask bar, or once the page is idle (not with Save-Data or on 2G; ~/scripts/chat.ts), so the widget costs almost
 *   nothing up front and the first open is instant.
 * - On phones the launcher steps aside while a form field has focus, while it is over a form and while the page
 *   scrolls down (~/scripts/chat.ts), and the chat opens as a native-feeling sheet (chat-widget README).
 * - Once the page has loaded, ~/scripts/chat-avatar.ts dresses the launcher as Hatem's avatar with a comic speech
 *   bubble (copy: chat.avatar). data-av-disc picks the disc: "dark" (lapis-night disc in a gold rim; the default) or "teal"
 *   (turquoise). `greet={false}` (data-av-greet="off": the CV, the 404) keeps the bubble for hover and focus only, and
 *   `launcher={false}` (data-launcher="off": the 404, whose own "Ask the assistant" opens the chat) keeps the launcher
 *   out of the page's corner until the chat is open (~/scripts/site.ts).
 * - Any element with [data-open-chat] (optional data-question) opens it; "/" outside a text field too
 *   (src/scripts/site.ts). Clicks before the loader runs are queued.
 * - Config comes from data attributes here (no inline script: strict CSP). Contact details come from profile.ts,
 *   never from the model.
 * - Without JavaScript, a <details> card offers email and WhatsApp instead. With JavaScript but no chat (its code
 *   failed to load, e.g. a page opened before a deploy whose chunks are gone), the same offer shows as a small card
 *   when an "Ask" button gets no panel within a few seconds (data-chat-fallback; ~/scripts/site.ts, audit R7-RES-04).
 *
 * Integration status: the coordinator finalises this file once the Worker's /api/chat is live
 * (e.g. Turnstile key and avatar). Tests mock window.MHChat (tests/e2e/chat.spec.ts).
 */
import { getImage } from "astro:assets";
import avatar from "~/assets/photo/mh-avatar-320.jpg";
import Icon from "~/components/ui/Icon.astro";
import { messages, type Locale } from "~/lib/i18n";
import { TURNSTILE_SITE_KEY, contact, link, mailtoHref, whatsappHref } from "~/lib/site";

interface Props {
  locale: Locale;
  /** The avatar says hello on its own (once per session, over empty page). Off on pages that ask for quiet. */
  greet?: boolean;
  /** The floating launcher sits in the page's corner. Off where the page offers the assistant itself (the 404). */
  launcher?: boolean;
}
const { locale, greet = true, launcher = true } = Astro.props;
const m = messages(locale);
const avatarImg = await getImage({ src: avatar, width: 96, height: 96, format: "webp" });
---
<div
  hidden
  id="mh-chat-config"
  data-lang={locale}
  data-turnstile={TURNSTILE_SITE_KEY}
  data-avatar={avatarImg.src}
  data-subtitle={m.chat.subtitle}
  data-whatsapp={contact("whatsapp").href.replace(/\D/g, "")}
  data-phone={contact("whatsapp").display}
  data-email={contact("email").display}
  data-alt-email={contact("gmail").display}
  data-linkedin={link("linkedin").href}
  data-github={link("github").href}
  data-av-name={m.chat.avatar.name}
  data-av-hi={m.chat.avatar.hi}
  data-av-text={m.chat.avatar.text}
  data-av-hide={m.chat.avatar.hide}
  data-av-disc="dark"
  data-av-greet={greet ? undefined : "off"}
  data-launcher={launcher ? undefined : "off"}
>
</div>
<section class="chat-fallback" hidden data-chat-fallback tabindex="-1" aria-labelledby="chat-fallback-text">
  <p id="chat-fallback-text">{m.chat.errors.unavailable}</p>
  <p class="chat-noscript__links">
    <a href={mailtoHref(locale)}>{m.chat.contactEmail}</a>
    <a href={whatsappHref(locale)}>{m.chat.contactWhatsApp}</a>
  </p>
  <button class="chat-fallback__close" type="button" data-chat-fallback-close aria-label={m.common.close} title={m.common.close}>
    <Icon name="close" size="sm" />
  </button>
</section>
<noscript>
  <details class="chat-noscript">
    <summary class="chat-noscript__launcher">
      <span class="chat-noscript__icon" aria-hidden="true"><Icon name="ask" /></span>
      <span>{m.chat.launcher}</span>
    </summary>
    <div class="chat-noscript__card">
      <p>{m.chat.noscript}</p>
      <p class="chat-noscript__links">
        <a href={mailtoHref(locale)}>{m.chat.contactEmail}</a>
        <a href={whatsappHref(locale)}>{m.chat.contactWhatsApp}</a>
      </p>
    </div>
  </details>
</noscript>
<script>
  import { mountChatWidget } from "~/scripts/chat";
  mountChatWidget();
</script>
