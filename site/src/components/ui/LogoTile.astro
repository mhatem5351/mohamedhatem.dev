---
/**
 * An organisation's logo tile (design/assets/logos/tiles: official logo on its native background, 22% radius) or,
 * when there is no logo, the monogram in the same tile. Decorative (alt=""): the organisation's name is always
 * next to it as text.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /** Tile key: a LogoFile from profile.ts, or "tabaqat" / "mtc" / "uqu" (monogram tiles from the design). */
  file: string | null;
  monogram: string;
  size?: number;
  class?: string;
}
const { file, monogram, size = 36, class: className } = Astro.props;
const tiles = import.meta.glob<{ default: ImageMetadata }>("../../assets/logos/tiles/*-160.webp", { eager: true });
const src = file ? tiles[`../../assets/logos/tiles/${file}-160.webp`]?.default : undefined;
---
{
  src ? (
    <Image src={src} alt="" width={size} height={size} densities={[1, 2]} class={className} loading="lazy" decoding="async" />
  ) : (
    <span class:list={[className, "logo-mono"]} aria-hidden="true">
      {monogram}
    </span>
  )
}
